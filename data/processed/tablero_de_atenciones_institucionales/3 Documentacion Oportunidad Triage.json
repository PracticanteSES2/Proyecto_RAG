{
  "source_file": "3 Documentacion Oportunidad Triage.docx",
  "relative_path": "tablero_de_atenciones_institucionales\\3 Documentacion Oportunidad Triage.docx",
  "source_folder": "tablero_de_atenciones_institucionales",
