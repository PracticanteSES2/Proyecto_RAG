          "style": "Normal"
        },
        {
          "index": 90,
          "type": "paragraph",
          "text": "Gráfico de Anillo",
          "style": "Normal"
        },
        {
          "index": 91,
          "type": "paragraph",
          "text": "Muestra el total de laboratorios patológicos diferenciados por cada categoría de EPS.",
          "style": "Normal"
        }
      ]
    }
  ]
