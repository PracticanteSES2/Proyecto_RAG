  "document_group": null,
  "dashboards": [
    {
      "name": "LABORATORIO CLÍNICO",
      "source_file": "16 Documentacion Tablero Laboratorios.docx",
      "blocks": [
        {
          "index": 1,
          "type": "paragraph",
          "text": "Este tablero permite analizar el comportamiento de las imágenes procesadas visualizando su evolución anual y facilitando el seguimiento del volumen de servicios prestados.",
          "style": "Normal"
        },
        {
          "index": 3,
          "type": "paragraph",
          "text": "CONSULTA UTILIZADA PARA CREAR ESTE TABLERO",
          "style": "Normal"
        },
        {
          "index": 4,
          "type": "paragraph",
          "text": "LABORATORIOS",
          "style": "Normal"
        },
        {
          "index": 5,
          "type": "paragraph",
          "text": "SELECT DISTINCT GENPACIEN.PACNUMDOC AS 'IDENTIFICACION',",
          "style": "Normal"
        },
        {
          "index": 6,
          "type": "paragraph",
          "text": "RTRIM(GENPACIEN.PACPRINOM) + ' ' + RTRIM(GENPACIEN.PACSEGNOM) + ' ' +",
          "style": "Normal"
        },
        {
          "index": 7,
          "type": "paragraph",
          "text": "RTRIM(GENPACIEN.PACPRIAPE) + ' ' + RTRIM(GENPACIEN.PACSEGAPE) AS 'PACIENTE',",
          "style": "Normal"
        },
        {
          "index": 8,
          "type": "paragraph",
          "text": "GENSERIPS.SIPCODIGO AS 'CODIGO',",
          "style": "Normal"
        },
        {
          "index": 9,
          "type": "paragraph",
          "text": "GENSERIPS.SIPCODCUP AS 'CUPS',",
          "style": "Normal"
        },
        {
          "index": 10,
          "type": "paragraph",
          "text": "UPPER(GENSERIPS.SIPNOMBRE) AS 'SERVICIO IPS',",
          "style": "Normal"
        },
        {
          "index": 11,
          "type": "paragraph",
          "text": "CAST(SLNSERPRO.SERFECSER AS DATE) AS 'FECHA_ATENCION',",
          "style": "Normal"
        },
        {
          "index": 12,
          "type": "paragraph",
          "text": "CASE",
          "style": "Normal"
        },
        {
          "index": 13,
          "type": "paragraph",
          "text": "WHEN ADNINGRESO.AINTIPING = '1' THEN 'AMBULATORIO'",
          "style": "Normal"
        },
        {
          "index": 14,
          "type": "paragraph",
          "text": "WHEN ADNINGRESO.AINTIPING = '2' THEN 'HOSPITALARIO'",
          "style": "Normal"
        },
        {
          "index": 15,
          "type": "paragraph",
          "text": "END AS 'TIPO_INGRESO',",
          "style": "Normal"
        },
        {
          "index": 16,
          "type": "paragraph",
          "text": "CASE",
          "style": "Normal"
        },
        {
          "index": 17,
          "type": "paragraph",
          "text": "WHEN ADNINGRESO.AINURGCON = '0' THEN 'URGENCIAS'",
          "style": "Normal"
        },
        {
          "index": 18,
          "type": "paragraph",
          "text": "WHEN ADNINGRESO.AINURGCON = '1' THEN 'CONSULTA EXTERNA'",
          "style": "Normal"
        },
        {
          "index": 19,
          "type": "paragraph",
          "text": "ELSE 'OTRO'",
          "style": "Normal"
        },
        {
          "index": 20,
          "type": "paragraph",
          "text": "END AS 'INGRESO POR',",
          "style": "Normal"
        },
        {
          "index": 21,
          "type": "paragraph",
          "text": "B.TERNOMCOM ASEGURADOR",
          "style": "Normal"
        },
        {
          "index": 22,
          "type": "paragraph",
          "text": "FROM SLNSERPRO",
          "style": "Normal"
        },
        {
          "index": 23,
          "type": "paragraph",
          "text": "INNER JOIN AREA_SERVICIO GENARESER ON SLNSERPRO.GENARESER1 = GENARESER.OID",
          "style": "Normal"
        },
        {
          "index": 24,
          "type": "paragraph",
          "text": "INNER JOIN DIM_INGRESO ADNINGRESO ON SLNSERPRO.ADNINGRES1 = ADNINGRESO.OID",
          "style": "Normal"
        },
        {
          "index": 25,
          "type": "paragraph",
          "text": "INNER JOIN DIM_PACIENTES GENPACIEN ON GENPACIEN.OID = ADNINGRESO.GENPACIEN",
          "style": "Normal"
        },
        {
          "index": 26,
          "type": "paragraph",
          "text": "INNER JOIN SLNSERHOJ ON SLNSERPRO.OID = SLNSERHOJ.OID",
          "style": "Normal"
        },
        {
          "index": 27,
          "type": "paragraph",
          "text": "INNER JOIN DIM_GENSERIPS GENSERIPS ON GENSERIPS.OID = SLNSERHOJ.GENSERIPS1",
          "style": "Normal"
        },
        {
          "index": 28,
          "type": "paragraph",
          "text": "INNER JOIN DIM_ASEGURADORA A ON A.OID=ADNINGRESO.GENDETCON",
          "style": "Normal"
        },
        {
          "index": 29,
          "type": "paragraph",
          "text": "INNER JOIN GENTERCER_DW B ON A.GENTERCER1=B.OID",
          "style": "Normal"
        },
        {
          "index": 30,
          "type": "paragraph",
          "text": "WHERE CAST(SLNSERPRO.SERFECSER AS DATE) BETWEEN '2025-01-01' AND CAST(GETDATE() AS DATE)",
          "style": "Normal"
        },
        {
          "index": 31,
          "type": "paragraph",
          "text": "AND SLNSERPRO.GENARESER1 = '15'",
          "style": "Normal"
        },
        {
          "index": 32,
          "type": "paragraph",
          "text": "AND ADNINGRESO.AINESTADO NOT IN (2, 4)",
          "style": "Normal"
        },
        {
          "index": 39,
          "type": "paragraph",
          "text": "DESCRIPCIÓN DE LOS VISUALES",
          "style": "Normal"
        },
        {
          "index": 40,
          "type": "paragraph",
          "text": "Filtros",
          "style": "Normal"
        },
        {
          "index": 41,
          "type": "paragraph",
          "text": "Permiten segmentar la información por Aseguradora, Año y Mes y tipo de ingreso, facilitando el análisis de los servicios de laboratorio según los criterios seleccionados.",
          "style": "Normal"
        },
        {
          "index": 43,
          "type": "paragraph",
          "text": "Gráfico de linea de Total de Imagenes",
          "style": "Normal"
        },
        {
          "index": 44,
          "type": "paragraph",
          "text": "Muestra la cantidad de imagenes realizadas por año, permitiendo comparar su comportamiento entre diferentes años.",
          "style": "Normal"
        },
        {
          "index": 46,
          "type": "paragraph",
          "text": "Tabla de detalle anual",
          "style": "Normal"
        },
        {
          "index": 47,
          "type": "paragraph",
          "text": "Presenta el consolidado mensual de servicios de imagenes, permitiendo analizar y comparar el comportamiento histórico de este indicador.",
          "style": "Normal"
        },
        {
          "index": 49,
          "type": "paragraph",
          "text": "Botón – Detalle Apoyo Diagnostico",
          "style": "Normal"
        },
        {
          "index": 50,
          "type": "paragraph",
          "text": "Permite acceder a un tablero adicional donde se visualiza la distribución de las imagenes por área de servicio.",
          "style": "Normal"
        }
      ]
    },
