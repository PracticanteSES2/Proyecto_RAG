  "semantic_model_key": "tablero_de_atenciones_institucionales",
  "semantic_model": "TABLERO DE ATENCIONES INSTITUCIONALES",
  "document_group": null,
  "dashboards": [
    {
      "name": "ATENCIONES EN QUIMIOTERAPIA",
      "source_file": "Documentacion Tablero Quimioterapia.docx",
      "blocks": [
        {
          "index": 1,
          "type": "paragraph",
          "text": "Este tablero permite analizar el comportamiento de las atenciones realizadas en el servicio de quimioterapia, facilitando el seguimiento del volumen de tratamientos y su evolución en el tiempo.",
          "style": "Normal"
        },
        {
          "index": 3,
          "type": "paragraph",
          "text": "CONSULTA UTILIZADA PARA CREAR ESTE TABLERO",
          "style": "Normal"
        },
        {
          "index": 4,
          "type": "paragraph",
          "text": "QUIMIOTERAPIA",
          "style": "Normal"
        },
        {
          "index": 5,
          "type": "paragraph",
          "text": "SELECT ADNINGRESO.AINCONSEC AS 'INGRESO'",
          "style": "Normal"
        },
        {
          "index": 6,
          "type": "paragraph",
          "text": ",ADNINGRESO.AINFECING AS 'FECHA_ADMISION'",
          "style": "Normal"
        },
        {
          "index": 7,
          "type": "paragraph",
          "text": ",CAST(AINFECING AS DATE) FECHA",
          "style": "Normal"
        },
        {
          "index": 8,
          "type": "paragraph",
          "text": ",GENPACIEN.PACNUMDOC AS 'IDENTIFICACION'",
          "style": "Normal"
        },
        {
          "index": 9,
          "type": "paragraph",
          "text": ",RTRIM(GENPACIEN.PACPRINOM) + ' ' + RTRIM(GENPACIEN.PACSEGNOM) + ' ' + RTRIM(GENPACIEN.PACPRIAPE) + ' ' + RTRIM(GENPACIEN.PACSEGAPE) AS 'USUARIO'",
          "style": "Normal"
        },
        {
          "index": 10,
          "type": "paragraph",
          "text": ",GENDETCON.GDENOMBRE AS 'ASEGURADOR',",
          "style": "Normal"
        },
        {
          "index": 11,
          "type": "paragraph",
          "text": "CASE WHEN ADNINGRESO.GENARESER = '108' THEN 'QUIMIOTERAPIA'",
          "style": "Normal"
        },
        {
          "index": 12,
          "type": "paragraph",
          "text": "ELSE 'OTRO' END AS 'SERVICIO QUE INGRESA'",
          "style": "Normal"
        },
        {
          "index": 13,
          "type": "paragraph",
          "text": "FROM DIM_INGRESO ADNINGRESO",
          "style": "Normal"
        },
        {
          "index": 14,
          "type": "paragraph",
          "text": "INNER JOIN DIM_PACIENTES GENPACIEN ON GENPACIEN.OID = ADNINGRESO.GENPACIEN",
          "style": "Normal"
        },
        {
          "index": 15,
          "type": "paragraph",
          "text": "INNER JOIN DIM_ASEGURADORA GENDETCON ON GENDETCON.OID = ADNINGRESO.GENDETCON",
          "style": "Normal"
        },
        {
          "index": 16,
          "type": "paragraph",
          "text": "WHERE GENARESER = '108'",
          "style": "Normal"
        },
        {
          "index": 17,
          "type": "paragraph",
          "text": "AND CAST(AINFECING AS date) BETWEEN '2023-01-01' AND CAST(GETDATE() AS DATE)",
          "style": "Normal"
        },
        {
          "index": 18,
          "type": "paragraph",
          "text": "AND ADNINGRESO.AINESTADO <> '2'",
          "style": "Normal"
        },
        {
          "index": 19,
          "type": "paragraph",
          "text": "DESCRIPCIÓN DE LOS VISUALES",
          "style": "Normal"
        },
        {
          "index": 20,
          "type": "paragraph",
          "text": "Filtros",
          "style": "Normal"
        },
        {
          "index": 21,
          "type": "paragraph",
          "text": "Permiten segmentar la información por Aseguradora, Año y Mes, facilitando el análisis de las atenciones en quimioterapia según los criterios seleccionados.",
          "style": "Normal"
        },
        {
          "index": 23,
          "type": "paragraph",
          "text": "Gráfico de columnas – Atenciones en quimioterapia",
          "style": "Normal"
        },
        {
          "index": 24,
          "type": "paragraph",
          "text": "Muestra la cantidad de atenciones realizadas por mes, permitiendo comparar su comportamiento entre diferentes años e identificar variaciones en la prestación del servicio.",
          "style": "Normal"
        },
        {
          "index": 26,
          "type": "paragraph",
          "text": "Tabla de detalle anual",
          "style": "Normal"
        },
        {
          "index": 27,
          "type": "paragraph",
          "text": "Presenta el consolidado mensual de atenciones en quimioterapia por año, permitiendo analizar y comparar el comportamiento histórico de este indicador.",
          "style": "Normal"
        }
      ]
    }
  ]
}