{
  "source_file": "6 Documentacion Tablero Consultas Prioritarias.docx",
  "relative_path": "tablero_de_atenciones_institucionales\\6 Documentacion Tablero Consultas Prioritarias.docx",
  "source_folder": "tablero_de_atenciones_institucionales",
  "workspace": "Gestion Clinica",
  "semantic_model_key": "tablero_de_atenciones_institucionales",
  "semantic_model": "TABLERO DE ATENCIONES INSTITUCIONALES",
  "document_group": null,
  "dashboards": [
    {
      "name": "CONSULTAS PRIORITARIAS",
      "source_file": "6 Documentacion Tablero Consultas Prioritarias.docx",
      "blocks": [
        {
          "index": 1,
          "type": "paragraph",
          "text": "Este tablero muestra gráficamente los pacientes observados en consultas prioritarias mensualmente, además muestra una tabla con el conteo de pacientes observados efectivamente en los dos años anteriores.",
          "style": "Normal"
        },
        {
          "index": 3,
          "type": "paragraph",
          "text": "Para la creación de este tablero se utilizó la siguiente consulta:",
          "style": "Normal"
        },
        {
          "index": 4,
          "type": "paragraph",
          "text": "SELECT DISTINCT GENDETCON.GDENOMBRE AS 'ASEGURADOR',",
          "style": "Normal"
        },
        {
          "index": 5,
          "type": "paragraph",
          "text": "CASE WHEN GENESPECI.GEEDESCRI LIKE '%HEMATOLOGIA%' THEN 'HEMATOLOGIA'",
          "style": "Normal"
        },
        {
          "index": 6,
          "type": "paragraph",
          "text": "WHEN GENESPECI.GEEDESCRI LIKE '%CUIDADO PALIATIVO%' THEN 'CUIDADO PALIATIVO'",
          "style": "Normal"
        },
        {
          "index": 7,
          "type": "paragraph",
          "text": "WHEN GENESPECI.GEEDESCRI LIKE '%MEDICINA INTERNA Y GERIATRIA%' THEN 'GERIATRIA'",
          "style": "Normal"
        },
        {
          "index": 8,
          "type": "paragraph",
          "text": "WHEN GENESPECI.GEEDESCRI = 'GERIATRIA' THEN 'GERIATRIA'",
          "style": "Normal"
        },
        {
          "index": 9,
          "type": "paragraph",
          "text": "WHEN GENESPECI.GEEDESCRI LIKE '%MEDICINA INTERNA Y NEUMOLOGIA%' THEN 'NEUMOLOGIA'",
          "style": "Normal"
        },
        {
          "index": 10,
          "type": "paragraph",
          "text": "WHEN CMNTIPACT.CMANOMBRE LIKE '%ESPIROMETRIA%' THEN 'REHABILITACION PULMONAR'",
          "style": "Normal"
        },
        {
          "index": 11,
          "type": "paragraph",
          "text": "WHEN CMNTIPACT.CMANOMBRE LIKE '%CAPACIDAD DE DIFUSION CON MONOXIDO DE CARBONO%' THEN 'REHABILITACION PULMONAR'",
          "style": "Normal"
        },
        {
          "index": 12,
          "type": "paragraph",
          "text": "WHEN CMNTIPACT.CMANOMBRE LIKE '%REHABILITACION PULMONAR%' THEN 'REHABILITACION PULMONAR'",
          "style": "Normal"
        },
        {
          "index": 13,
          "type": "paragraph",
          "text": "WHEN CMNTIPACT.CMANOMBRE LIKE '%TEST DE CAMINATA%' THEN 'REHABILITACION CARDIACA'",
          "style": "Normal"
        },
        {
          "index": 14,
          "type": "paragraph",
          "text": "WHEN CMNTIPACT.CMANOMBRE LIKE '%REHABILITACION CARDIACA%' THEN 'REHABILITACION CARDIACA'",
          "style": "Normal"
        },
        {
          "index": 15,
          "type": "paragraph",
          "text": "ELSE GENESPECI.GEEDESCRI END AS 'ESPECIALIDAD',",
          "style": "Normal"
        },
        {
          "index": 16,
          "type": "paragraph",
          "text": "GENMEDICO.GMENOMCOM AS 'MEDICO',",
          "style": "Normal"
        },
        {
          "index": 17,
          "type": "paragraph",
          "text": "GENPACIEN.PACNUMDOC AS 'IDENTIFICACION',",
          "style": "Normal"
        },
        {
          "index": 18,
          "type": "paragraph",
          "text": "CMNCITMED.CCMPACNOM AS 'PACIENTE',",
          "style": "Normal"
        },
        {
          "index": 19,
          "type": "paragraph",
          "text": "--CMNCITMED.CCMFECASI AS 'FECHA_ASIGNA_CITA',",
          "style": "Normal"
        },
        {
          "index": 20,
          "type": "paragraph",
          "text": "CMNCITMED.CCMFECCIT AS 'FECHA_CITA',",
          "style": "Normal"
        },
        {
          "index": 21,
          "type": "paragraph",
          "text": "CAST(CCMFECCIT AS DATE)FECHA,",
          "style": "Normal"
        },
        {
          "index": 22,
          "type": "paragraph",
          "text": "--CMNCITMED.CCMFECPAC AS 'FECHA_QUIERE_CITA',",
          "style": "Normal"
        },
        {
          "index": 23,
          "type": "paragraph",
          "text": "--HCNFOLIO.HCFECFOLI AS 'FECHA_ABRE_FOLIO',",
          "style": "Normal"
        },
        {
          "index": 24,
          "type": "paragraph",
          "text": "--DATEDIFF(DD, CMNCITMED.CCMFECASI, CMNCITMED.CCMFECCIT) AS DIAS,",
          "style": "Normal"
        },
        {
          "index": 25,
          "type": "paragraph",
          "text": "-- DATEDIFF(HH, CMNCITMED.CCMFECASI, CMNCITMED.CCMFECCIT) AS HORAS,",
          "style": "Normal"
        },
        {
          "index": 26,
          "type": "paragraph",
          "text": "-- DATEDIFF(MI, CMNCITMED.CCMFECCIT, HCNFOLIO.HCFECFOLI) AS MINUTOS,",
          "style": "Normal"
        },
        {
          "index": 27,
          "type": "paragraph",
          "text": "--CASE WHEN GENPACIEN.PACTIPDOC = 1 THEN 'CC'",
          "style": "Normal"
        },
        {
          "index": 28,
          "type": "paragraph",
          "text": "-- WHEN GENPACIEN.PACTIPDOC = 2 THEN 'CE'",
          "style": "Normal"
        },
        {
          "index": 29,
          "type": "paragraph",
          "text": "-- WHEN GENPACIEN.PACTIPDOC = 3 THEN 'TI'",
          "style": "Normal"
        },
        {
          "index": 30,
          "type": "paragraph",
          "text": "-- WHEN GENPACIEN.PACTIPDOC = 4 THEN 'RC'",
          "style": "Normal"
        },
        {
          "index": 31,
          "type": "paragraph",
          "text": "-- WHEN GENPACIEN.PACTIPDOC = 5 THEN 'PA'",
          "style": "Normal"
        },
        {
          "index": 32,
          "type": "paragraph",
          "text": "-- WHEN GENPACIEN.PACTIPDOC = 6 THEN 'AS'",
          "style": "Normal"
        },
        {
          "index": 33,
          "type": "paragraph",
          "text": "-- WHEN GENPACIEN.PACTIPDOC = 7 THEN 'MS'",
          "style": "Normal"
        },
        {
          "index": 34,
          "type": "paragraph",
          "text": "-- WHEN GENPACIEN.PACTIPDOC = 8 THEN 'CC'",
          "style": "Normal"
        },
        {
          "index": 35,
          "type": "paragraph",
          "text": "-- WHEN GENPACIEN.PACTIPDOC = 9 THEN 'SC'",
          "style": "Normal"
        },
        {
          "index": 36,
          "type": "paragraph",
          "text": "-- WHEN GENPACIEN.PACTIPDOC = 10 THEN 'CN'",
          "style": "Normal"
        },
        {
          "index": 37,
          "type": "paragraph",
          "text": "-- WHEN GENPACIEN.PACTIPDOC = 11 THEN 'CD'",
          "style": "Normal"
        },
        {
          "index": 38,
          "type": "paragraph",
          "text": "-- WHEN GENPACIEN.PACTIPDOC = 12 THEN 'PT'",
          "style": "Normal"
        },
        {
          "index": 39,
          "type": "paragraph",
          "text": "-- WHEN GENPACIEN.PACTIPDOC = 14 THEN 'PE'",
          "style": "Normal"
        },
        {
          "index": 40,
          "type": "paragraph",
          "text": "--END AS 'TIPO_IDENT',",
          "style": "Normal"
        },
        {
          "index": 41,
          "type": "paragraph",
          "text": "--GENDEPTO.DEPCODDEP AS 'DEPTO',",
          "style": "Normal"
        },
        {
          "index": 42,
          "type": "paragraph",
          "text": "--GENMUNICI.MUNCODMUN AS 'MUNICI',",
          "style": "Normal"
        },
        {
          "index": 43,
          "type": "paragraph",
          "text": "--(SELECT TOP (1) REPLACE(REPLACE(REPLACE(GENPACIENT.PACTELEFONO, CHAR(9), ''), CHAR(10), ''), CHAR(13), '')",
          "style": "Normal"
        },
        {
          "index": 44,
          "type": "paragraph",
          "text": "--FROM DGEMPRES10.DBO.GENPACIENT WHERE GENPACIENT.GENPACIEN = GENPACIEN.OID) AS TELEFONO,",
          "style": "Normal"
        },
        {
          "index": 45,
          "type": "paragraph",
          "text": "--(SELECT TOP (1) REPLACE(REPLACE(REPLACE(GENPACIEND.PACDIRECCION, CHAR(9), ''), CHAR(10), ''), CHAR(13), '')",
          "style": "Normal"
        },
        {
          "index": 46,
          "type": "paragraph",
          "text": "--FROM DGEMPRES10.DBO.GENPACIEND WHERE GENPACIEND.GENPACIEN = GENPACIEN.OID) AS DIRECCION,",
          "style": "Normal"
        },
        {
          "index": 47,
          "type": "paragraph",
          "text": "CMNTIPACT.CMANOMBRE AS 'TIPO_ATENCION',",
          "style": "Normal"
        },
        {
          "index": 48,
          "type": "paragraph",
          "text": "--CASE WHEN HCM0CONEX.HCCM09N13 is NULL AND CMNTIPACT.CMANOMBRE LIKE '%PRIMERA VEZ%' THEN 'Primera Vez'",
          "style": "Normal"
        },
        {
          "index": 49,
          "type": "paragraph",
          "text": "-- WHEN HCM0CONEX.HCCM09N13 is NULL AND CMNTIPACT.CMANOMBRE NOT LIKE '%PRIMERA VEZ%' THEN 'Control'",
          "style": "Normal"
        },
        {
          "index": 50,
          "type": "paragraph",
          "text": "-- ELSE HCM0CONEX.HCCM09N13",
          "style": "Normal"
        },
        {
          "index": 51,
          "type": "paragraph",
          "text": "--END as 'PV_CONTROL',",
          "style": "Normal"
        },
        {
          "index": 52,
          "type": "paragraph",
          "text": "CASE WHEN CMNCITMED.CCMESTADO = '0' THEN 'ASIGNADA'",
          "style": "Normal"
        },
        {
          "index": 53,
          "type": "paragraph",
          "text": "WHEN CMNCITMED.CCMESTADO = '1' THEN 'CANCELADA'",
          "style": "Normal"
        },
        {
          "index": 54,
          "type": "paragraph",
          "text": "WHEN CMNCITMED.CCMESTADO = '2' THEN 'CUMPLIDA'",
          "style": "Normal"
        },
        {
          "index": 55,
          "type": "paragraph",
          "text": "WHEN CMNCITMED.CCMESTADO = '3' THEN 'INCUMPLIDA'",
          "style": "Normal"
        },
        {
          "index": 56,
          "type": "paragraph",
          "text": "WHEN CMNCITMED.CCMESTADO = '4' THEN 'FACTURADA'",
          "style": "Normal"
        },
        {
          "index": 57,
          "type": "paragraph",
          "text": "WHEN CMNCITMED.CCMESTADO = '5' THEN 'INATENCION'",
          "style": "Normal"
        },
        {
          "index": 58,
          "type": "paragraph",
          "text": "END AS 'ESTADO_CITA',",
          "style": "Normal"
        },
        {
          "index": 59,
          "type": "paragraph",
          "text": "GENTERCER_DW.TERNOMCOM--,",
          "style": "Normal"
        },
        {
          "index": 60,
          "type": "paragraph",
          "text": "--CMNCITMED.GENESPECI AS 'ESPECI_CITA',",
          "style": "Normal"
        },
        {
          "index": 61,
          "type": "paragraph",
          "text": "--HCNFOLIO.GENESPECI AS 'ESPECI_FOLI',",
          "style": "Normal"
        },
        {
          "index": 62,
          "type": "paragraph",
          "text": "--GENESPECI.GEEDESCRI AS GEEDESCRI1,",
          "style": "Normal"
        },
        {
          "index": 63,
          "type": "paragraph",
          "text": "-- GENESPECI1.GEEDESCRI,",
          "style": "Normal"
        },
        {
          "index": 64,
          "type": "paragraph",
          "text": "-- -- Modificación para aplicar el cambio solicitado",
          "style": "Normal"
        },
        {
          "index": 65,
          "type": "paragraph",
          "text": "--CASE WHEN GENESPECI.GEEDESCRI = 'CIRUGIA VASCULAR' AND GENESPECI.GEEDESCRI <> GENESPECI1.GEEDESCRI THEN 'CIRUGIA VASCULAR'",
          "style": "Normal"
        },
        {
          "index": 66,
          "type": "paragraph",
          "text": "-- WHEN GENESPECI.GEEDESCRI = 'CIRUGIA DE MANO Y MIEMBRO SUPERIOR' AND GENESPECI.GEEDESCRI <> GENESPECI1.GEEDESCRI THEN 'CIRUGIA DE MANO Y MIEMBRO SUPERIOR'",
          "style": "Normal"
        },
        {
          "index": 67,
          "type": "paragraph",
          "text": "-- WHEN GENESPECI.GEEDESCRI = 'CIRUGIA GENERAL' AND GENESPECI.GEEDESCRI <> GENESPECI1.GEEDESCRI THEN 'CIRUGIA GENERAL'",
          "style": "Normal"
        },
        {
          "index": 68,
          "type": "paragraph",
          "text": "-- WHEN GENESPECI.GEEDESCRI = 'CIRUGIA PLASTICA' AND GENESPECI.GEEDESCRI <> GENESPECI1.GEEDESCRI THEN 'CIRUGIA PLASTICA'",
          "style": "Normal"
        },
        {
          "index": 69,
          "type": "paragraph",
          "text": "-- WHEN GENESPECI.GEEDESCRI = 'CUIDADO PALIATIVO' AND GENESPECI.GEEDESCRI <> GENESPECI1.GEEDESCRI THEN 'CUIDADO PALIATIVO'",
          "style": "Normal"
        },
        {
          "index": 70,
          "type": "paragraph",
          "text": "-- WHEN GENESPECI.GEEDESCRI = 'FISIOTERAPIA' AND GENESPECI.GEEDESCRI <> GENESPECI1.GEEDESCRI THEN 'FISIOTERAPIA'",
          "style": "Normal"
        },
        {
          "index": 71,
          "type": "paragraph",
          "text": "-- WHEN GENESPECI.GEEDESCRI = 'GINECOLOGIA- OBSTETRICIA' AND GENESPECI.GEEDESCRI <> GENESPECI1.GEEDESCRI THEN 'GINECOLOGIA- OBSTETRICIA'",
          "style": "Normal"
        },
        {
          "index": 72,
          "type": "paragraph",
          "text": "-- WHEN GENESPECI.GEEDESCRI = 'PEDIATRIA' AND GENESPECI.GEEDESCRI <> GENESPECI1.GEEDESCRI THEN 'PEDIATRIA'",
          "style": "Normal"
        },
        {
          "index": 73,
          "type": "paragraph",
          "text": "-- WHEN GENESPECI.GEEDESCRI = 'PERINATOLOGIA' AND GENESPECI.GEEDESCRI <> GENESPECI1.GEEDESCRI THEN 'PERINATOLOGIA'",
          "style": "Normal"
        },
        {
          "index": 74,
          "type": "paragraph",
          "text": "-- WHEN GENESPECI1.GEEDESCRI = 'GERIATRIA' AND GENESPECI.GEEDESCRI <> GENESPECI1.GEEDESCRI THEN GENESPECI1.GEEDESCRI",
          "style": "Normal"
        },
        {
          "index": 75,
          "type": "paragraph",
          "text": "-- ELSE GENESPECI.GEEDESCRI",
          "style": "Normal"
        },
        {
          "index": 76,
          "type": "paragraph",
          "text": "--END AS 'NUEVA_ESPECIALIDAD'",
          "style": "Normal"
        },
        {
          "index": 77,
          "type": "paragraph",
          "text": "--CASE WHEN GENESPECI.GEEDESCRI = GENESPECI1.GEEDESCRI THEN 'VERDADERO'",
          "style": "Normal"
        },
        {
          "index": 78,
          "type": "paragraph",
          "text": "-- ELSE 'FALSO'",
          "style": "Normal"
        },
        {
          "index": 79,
          "type": "paragraph",
          "text": "--END AS 'COMPARACION'",
          "style": "Normal"
        },
        {
          "index": 80,
          "type": "paragraph",
          "text": "FROM CITAS_MEDICAS AS CMNCITMED",
          "style": "Normal"
        },
        {
          "index": 81,
          "type": "paragraph",
          "text": "LEFT OUTER JOIN DIM_FOLIO AS HCNFOLIO ON CMNCITMED.GENPACIEN = HCNFOLIO.GENPACIEN",
          "style": "Normal"
        },
        {
          "index": 82,
          "type": "paragraph",
          "text": "AND CAST(CMNCITMED.CCMFECCIT AS DATE) = CAST(HCNFOLIO.HCFECFOL AS DATE)",
          "style": "Normal"
        },
        {
          "index": 83,
          "type": "paragraph",
          "text": "AND (CMNCITMED.GENMEDICO1 = HCNFOLIO.GENMEDICO OR CMNCITMED.GENESPECI = HCNFOLIO.GENESPECI)",
          "style": "Normal"
        },
        {
          "index": 84,
          "type": "paragraph",
          "text": "INNER JOIN DIM_PACIENTES AS GENPACIEN ON GENPACIEN.OID = CMNCITMED.GENPACIEN",
          "style": "Normal"
        },
        {
          "index": 85,
          "type": "paragraph",
          "text": "INNER JOIN DIM_MEDICO AS GENMEDICO ON GENMEDICO.OID = CMNCITMED.GENMEDICO1",
          "style": "Normal"
        },
        {
          "index": 86,
          "type": "paragraph",
          "text": "INNER JOIN DIM_ESPECIALIDAD AS GENESPECI ON GENESPECI.OID = CMNCITMED.GENESPECI",
          "style": "Normal"
        },
        {
          "index": 87,
          "type": "paragraph",
          "text": "INNER JOIN CMNTIPACT ON CMNCITMED.CMNTIPACT = CMNTIPACT.OID",
          "style": "Normal"
        },
        {
          "index": 88,
          "type": "paragraph",
          "text": "--INNER JOIN DGEMPRES10.DBO.GENMUNICI ON GENMUNICI.OID = GENPACIEN.DGNMUNICIPIO",
          "style": "Normal"
        },
        {
          "index": 89,
          "type": "paragraph",
          "text": "--INNER JOIN DGEMPRES10.DBO.GENDEPTO ON GENMUNICI.GENDEPTO = GENDEPTO.OID",
          "style": "Normal"
        },
        {
          "index": 90,
          "type": "paragraph",
          "text": "LEFT OUTER JOIN DIM_ASEGURADORA AS GENDETCON ON GENDETCON.OID = GENPACIEN.GENDETCON",
          "style": "Normal"
        },
        {
          "index": 91,
          "type": "paragraph",
          "text": "LEFT OUTER JOIN DGEMPRES10.DBO.HCM0CONEX ON HCNFOLIO.OID = HCM0CONEX.HCNFOLIO",
          "style": "Normal"
        },
        {
          "index": 92,
          "type": "paragraph",
          "text": "LEFT OUTER JOIN DIM_ESPECIALIDAD GENESPECI1 ON GENESPECI1.OID = HCNFOLIO.GENESPECI",
          "style": "Normal"
        },
        {
          "index": 93,
          "type": "paragraph",
          "text": "LEFT JOIN GENTERCER_DW ON GENDETCON.GENTERCER1=GENTERCER_DW.OID",
          "style": "Normal"
        },
        {
          "index": 94,
          "type": "paragraph",
          "text": "WHERE CAST(CMNCITMED.CCMFECCIT AS DATE) BETWEEN '2024-01-01' AND CAST(GETDATE() AS DATE)",
          "style": "Normal"
        },
        {
          "index": 95,
          "type": "paragraph",
          "text": "AND CMNCITMED.CCMFECCIT < DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE()), 0)",
          "style": "Normal"
        },
        {
          "index": 96,
          "type": "paragraph",
          "text": "AND GENESPECI.OID NOT IN ('1', '2', '3', '4', '6', '8', '51', '65', '88', '90', '129')",
          "style": "Normal"
        },
        {
          "index": 97,
          "type": "paragraph",
          "text": "AND HCNFOLIO.HCFECFOLI IS NOT NULL",
          "style": "Normal"
        },
        {
          "index": 98,
          "type": "paragraph",
          "text": "AND HCNFOLIO.HCFECFOLI <> ''",
          "style": "Normal"
        },
        {
          "index": 99,
          "type": "paragraph",
          "text": "AND CMNCITMED.CCMESTADO <> '1'",
          "style": "Normal"
        },
        {
          "index": 100,
          "type": "paragraph",
          "text": "and CMNTIPACT.CMANOMBRE like '%PRIORI%'",
          "style": "Normal"
        },
        {
          "index": 101,
          "type": "paragraph",
          "text": "ORDER BY PACNUMDOC",
          "style": "Normal"
        },
        {
          "index": 102,
          "type": "paragraph",
          "text": "--GROUP BY GENDETCON.GDENOMBRE,",
          "style": "Normal"
        },
        {
          "index": 103,
          "type": "paragraph",
          "text": "-- GENMEDICO.GMENOMCOM,",
          "style": "Normal"
        },
        {
          "index": 104,
          "type": "paragraph",
          "text": "-- GENPACIEN.PACNUMDOC,",
          "style": "Normal"
        },
        {
          "index": 105,
          "type": "paragraph",
          "text": "-- CMNCITMED.CCMPACNOM,",
          "style": "Normal"
        },
        {
          "index": 106,
          "type": "paragraph",
          "text": "-- CMNCITMED.CCMFECASI,",
          "style": "Normal"
        },
        {
          "index": 107,
          "type": "paragraph",
          "text": "-- CMNCITMED.CCMFECCIT,",
          "style": "Normal"
        },
        {
          "index": 108,
          "type": "paragraph",
          "text": "-- CMNCITMED.CCMFECPAC,",
          "style": "Normal"
        },
        {
          "index": 109,
          "type": "paragraph",
          "text": "-- CMNCITMED.CCMFECLLE,",
          "style": "Normal"
        },
        {
          "index": 110,
          "type": "paragraph",
          "text": "-- GENDEPTO.DEPCODDEP,",
          "style": "Normal"
        },
        {
          "index": 111,
          "type": "paragraph",
          "text": "-- GENMUNICI.MUNCODMUN,",
          "style": "Normal"
        },
        {
          "index": 112,
          "type": "paragraph",
          "text": "-- CMNTIPACT.CMANOMBRE,",
          "style": "Normal"
        },
        {
          "index": 113,
          "type": "paragraph",
          "text": "-- HCM0CONEX.HCCM09N13,",
          "style": "Normal"
        },
        {
          "index": 114,
          "type": "paragraph",
          "text": "-- CMNCITMED.GENESPECI,",
          "style": "Normal"
        },
        {
          "index": 115,
          "type": "paragraph",
          "text": "-- HCNFOLIO.GENESPECI,",
          "style": "Normal"
        },
        {
          "index": 116,
          "type": "paragraph",
          "text": "-- GENESPECI.GEEDESCRI,",
          "style": "Normal"
        },
        {
          "index": 117,
          "type": "paragraph",
          "text": "-- HCNFOLIO.HCFECFOLI,",
          "style": "Normal"
        },
        {
          "index": 118,
          "type": "paragraph",
          "text": "-- GENPACIEN.PACTIPDOC,",
          "style": "Normal"
        },
        {
          "index": 119,
          "type": "paragraph",
          "text": "-- GENPACIEN.OID,",
          "style": "Normal"
        },
        {
          "index": 120,
          "type": "paragraph",
