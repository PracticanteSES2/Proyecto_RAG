  "dashboards": [
    {
      "name": "PORCENTAJE OCUPACIONAL",
      "source_file": "Documentacion Tablero %Ocupacional.docx",
      "blocks": [
        {
          "index": 1,
          "type": "paragraph",
          "text": "Este tablero permite analizar el porcentaje de ocupación de camas por servicio, facilitando el seguimiento del comportamiento de la ocupación hospitalaria a lo largo del tiempo.",
          "style": "Normal"
        },
        {
          "index": 3,
          "type": "paragraph",
          "text": "CONSULTA UTILIZADA PARA CREAR ESTE TABLERO",
          "style": "Normal"
        },
        {
          "index": 4,
          "type": "paragraph",
          "text": "PORCENTAJE_OCUP",
          "style": "Normal"
        },
        {
          "index": 5,
          "type": "paragraph",
          "text": "SELECT",
          "style": "Normal"
        },
        {
          "index": 6,
          "type": "paragraph",
          "text": "case when co.codcama is null then ec.codcama else co.codcama end codcama,",
          "style": "Normal"
        },
        {
          "index": 7,
          "type": "paragraph",
          "text": "CASE WHEN cast(co.fechades as date) IS NULL THEN CAST(EC.fechades AS DATE) ELSE CAST(CO.FECHADES AS DATE) END fecha,",
          "style": "Normal"
        },
        {
          "index": 8,
          "type": "paragraph",
          "text": "CASE when co.codcama like '%crit%' or ec.codcama like '%crit%' then 'CUIDADO CRÍTICO OBSTETRICO'",
          "style": "Normal"
        },
        {
          "index": 9,
          "type": "paragraph",
          "text": "WHEN co.servicio IS NULL AND EC.CODCAMA NOT LIKE '%CRIT%' THEN EC.SERVICIO",
          "style": "Normal"
        },
        {
          "index": 10,
          "type": "paragraph",
          "text": "WHEN CO.SERVICIO IS NULL AND EC.CODCAMA LIKE '%CRIT%' THEN 'CUIDADO CRÍTICO OBSTETRICO'",
          "style": "Normal"
        },
        {
          "index": 11,
          "type": "paragraph",
          "text": "WHEN CO.SERVICIO IS NOT NULL AND CO.CODCAMA LIKE '%CRIT%' THEN 'CUIDADO CRÍTICO OBSTETRICO'",
          "style": "Normal"
        },
        {
          "index": 12,
          "type": "paragraph",
          "text": "WHEN CO.SERVICIO IS NOT NULL AND CO.CODCAMA NOT LIKE '%CRIT%' THEN CO.SERVICIO",
          "style": "Normal"
        },
        {
          "index": 13,
          "type": "paragraph",
          "text": "ELSE CO.SERVICIO END SERVICIO,",
          "style": "Normal"
        },
        {
          "index": 14,
          "type": "paragraph",
          "text": "CASE",
          "style": "Normal"
        },
        {
          "index": 15,
          "type": "paragraph",
          "text": "WHEN co.codcama IS NOT NULL THEN 'OCUPADA' -- Si hay registro en camas ocupadas, se marca como ocupada",
          "style": "Normal"
        },
        {
          "index": 16,
          "type": "paragraph",
          "text": "when co.codcama is null and ec.estado is not null then 'DISPONIBLE'-- Si no hay registro en camas ocupadas, se toma el estado de la tabla de estados",
          "style": "Normal"
        },
        {
          "index": 17,
          "type": "paragraph",
          "text": "END AS estado",
          "style": "Normal"
        },
        {
          "index": 18,
          "type": "paragraph",
          "text": "FROM",
          "style": "Normal"
        },
        {
          "index": 19,
          "type": "paragraph",
          "text": "[dwses].[dbo].[estados_camas] ec",
          "style": "Normal"
        },
        {
          "index": 20,
          "type": "paragraph",
          "text": "LEFT JOIN",
          "style": "Normal"
        },
        {
          "index": 21,
          "type": "paragraph",
          "text": "[dwses].[dbo]",
          "style": "Normal"
        },
        {
          "index": 23,
          "type": "paragraph",
          "text": "MEDIDAS UTILIZADAS EN ESTE TABLERO",
          "style": "Normal"
        },
        {
          "type": "table",
          "rows": [
            [
              "Tabla",
              "Nombre Medida",
              "DAX"
            ],
            [
              "PORCENTAJE_OCUP",
              "%OCUPACIONALC",
              "SUM(PORCENTAJE_OCUP[OCUPADA])/SUM(PORCENTAJE_OCUP[DISPONIBLE])"
            ]
          ],
          "index": 24
        },
        {
          "index": 26,
          "type": "paragraph",
          "text": "COLUMNAS CALCULADAS UTILIZADAS EN ESTE TABLERO",
          "style": "Normal"
        },
        {
          "type": "table",
          "rows": [
            [
              "Tabla",
              "Columna",
              "DAX"
            ],
            [
              "PORCENTAJE_OCUP",
              "OCUPADA",
              "IF(PORCENTAJE_OCUP[ESTADO]=\"OCUPADA\" || PORCENTAJE_OCUP[ESTADO]=\"2\",1,0)"
            ],
            [
              "PORCENTAJE_OCUP",
              "DISPONIBLE",
              "IF(PORCENTAJE_OCUP[estado]=\"OCUPADA\" || PORCENTAJE_OCUP[estado]=\"1\" ||PORCENTAJE_OCUP[estado]=\"DESOCUPADA\" || PORCENTAJE_OCUP[estado]=\"MANTENIMIENTO\" || PORCENTAJE_OCUP[estado]=\"2\" || PORCENTAJE_OCUP[estado]=\"5\" || PORCENTAJE_OCUP[estado]=\"DISPONIBLE\",1,0)"
            ],
            [
              "PORCENTAJE_OCUP",
              "servicio_uni",
              "IF(SEARCH(\"CRIT\",PORCENTAJE_OCUP[SERVICIO],1,0)<>0,\"CUIDADO CRÍTICO OBSTETRICO\",PORCENTAJE_OCUP[SERVICIO])"
            ]
          ],
          "index": 27
        },
        {
          "index": 29,
          "type": "paragraph",
          "text": "DESCRIPCIÓN DE LOS VISUALES",
          "style": "Normal"
        },
        {
          "index": 30,
          "type": "paragraph",
          "text": "Filtros",
          "style": "Normal"
        },
        {
          "index": 31,
          "type": "paragraph",
          "text": "Permiten segmentar la información por Servicio, Año y Mes, facilitando el análisis del porcentaje de ocupación según los criterios seleccionados.",
          "style": "Normal"
        },
        {
          "index": 34,
          "type": "paragraph",
          "text": "Gráfico de líneas – Porcentaje ocupacional por año y mes",
          "style": "Normal"
        },
        {
          "index": 35,
          "type": "paragraph",
          "text": "Muestra la evolución del porcentaje de ocupación hospitalaria por mes, permitiendo analizar tendencias y variaciones en los diferentes años.",
          "style": "Normal"
        },
        {
          "index": 37,
          "type": "paragraph",
          "text": "Tabla de detalle anual",
          "style": "Normal"
        },
        {
          "index": 38,
          "type": "paragraph",
          "text": "Presenta el consolidado mensual del porcentaje de ocupación por año, permitiendo validar y comparar el comportamiento histórico del indicador.",
          "style": "Normal"
        },
        {
          "index": 40,
          "type": "paragraph",
          "text": "Tabla – Porcentaje ocupacional por servicio",
          "style": "Normal"
        },
        {
          "index": 41,
          "type": "paragraph",
          "text": "Muestra el porcentaje de ocupación registrado en cada servicio, facilitando identificar las áreas con mayor o menor nivel de ocupación.",
          "style": "Normal"
        }
      ]
    }
  ]
