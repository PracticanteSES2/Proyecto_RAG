{
  "source_file": "7 Documentacion Tablero Oportunidad Consultas Urgencias.docx",
  "relative_path": "tablero_de_atenciones_institucionales\\7 Documentacion Tablero Oportunidad Consultas Urgencias.docx",
  "source_folder": "tablero_de_atenciones_institucionales",
  "workspace": "Gestion Clinica",
  "semantic_model_key": "tablero_de_atenciones_institucionales",
  "semantic_model": "TABLERO DE ATENCIONES INSTITUCIONALES",
  "document_group": null,
  "dashboards": [
    {
      "name": "OPORTUNIDAD URGENCIAS",
      "source_file": "7 Documentacion Tablero Oportunidad Consultas Urgencias.docx",
      "blocks": [
        {
          "index": 1,
          "type": "paragraph",
          "text": "Este tablero muestra gráficamente el promedio de las consultas realizadas en urgencias, además de una tabla con el histórico de tiempo mensual durante los últimos dos años, es importante para tener claridad acerca de los tiempos de consulta en el área de urgencias.",
          "style": "Normal"
        },
        {
          "index": 3,
          "type": "paragraph",
          "text": "La consulta utilizada para la creación de este tablero fue:",
          "style": "Normal"
        },
        {
          "index": 4,
          "type": "paragraph",
          "text": "SELECT GENPACIEN.PACNUMDOC AS 'IDENTIFICACION', ADNINGRESO.AINCONSEC AS 'INGRESO', HCNTRIAGE.GPADOCUME AS 'DOCUMENTO',",
          "style": "Normal"
        },
        {
          "index": 5,
          "type": "paragraph",
          "text": "CASE WHEN HCNCLAURGTR.HCCODIGO = 'I' THEN 'I'",
          "style": "Normal"
        },
        {
          "index": 6,
          "type": "paragraph",
          "text": "WHEN HCNCLAURGTR.HCCODIGO = 'I-G' THEN 'I-G'",
          "style": "Normal"
        },
        {
          "index": 7,
          "type": "paragraph",
          "text": "WHEN HCNCLAURGTR.HCCODIGO = 'II' THEN 'II'",
          "style": "Normal"
        },
        {
          "index": 8,
          "type": "paragraph",
          "text": "WHEN HCNCLAURGTR.HCCODIGO = 'II-G' THEN 'II-G'",
          "style": "Normal"
        },
        {
          "index": 9,
          "type": "paragraph",
          "text": "WHEN HCNCLAURGTR.HCCODIGO = 'III' THEN 'III'",
          "style": "Normal"
        },
        {
          "index": 10,
          "type": "paragraph",
          "text": "WHEN HCNCLAURGTR.HCCODIGO = 'III-G' THEN 'III-G'",
          "style": "Normal"
        },
        {
          "index": 11,
          "type": "paragraph",
          "text": "WHEN HCNCLAURGTR.HCCODIGO = 'IIIU' THEN 'III'",
          "style": "Normal"
        },
        {
          "index": 12,
          "type": "paragraph",
          "text": "WHEN HCNCLAURGTR.HCCODIGO = 'IIP' THEN 'II'",
          "style": "Normal"
        },
        {
          "index": 13,
          "type": "paragraph",
          "text": "WHEN HCNCLAURGTR.HCCODIGO = 'IIS' THEN 'II'",
          "style": "Normal"
        },
        {
          "index": 14,
          "type": "paragraph",
          "text": "WHEN HCNCLAURGTR.HCCODIGO = 'IV' THEN 'IV'",
          "style": "Normal"
        },
        {
          "index": 15,
          "type": "paragraph",
          "text": "WHEN HCNCLAURGTR.HCCODIGO = 'IV-G' THEN 'IV-G'",
          "style": "Normal"
        },
        {
          "index": 16,
          "type": "paragraph",
          "text": "WHEN HCNCLAURGTR.HCCODIGO = 'M' THEN 'MUERTO'",
          "style": "Normal"
        },
        {
          "index": 17,
          "type": "paragraph",
          "text": "WHEN HCNCLAURGTR.HCCODIGO = 'V' THEN 'V'",
          "style": "Normal"
        },
        {
          "index": 18,
          "type": "paragraph",
          "text": "WHEN HCNCLAURGTR.HCCODIGO = 'V-G' THEN 'V-G'",
          "style": "Normal"
        },
        {
          "index": 19,
          "type": "paragraph",
          "text": "END 'CLASIFICACION_TRIAGE',",
          "style": "Normal"
        },
        {
          "index": 20,
          "type": "paragraph",
          "text": "GENPACIEN.GPANOMCOM AS 'PACIENTE',",
          "style": "Normal"
        },
        {
          "index": 21,
          "type": "paragraph",
          "text": "CASE",
          "style": "Normal"
        },
        {
          "index": 22,
          "type": "paragraph",
          "text": "WHEN HCNCONTRDT.HCCFECTUR IS NULL THEN CONVERT(VARCHAR(20), HCTFECTRI, 103)+' '+CONVERT(VARCHAR(8), HCTFECTRI, 114)",
          "style": "Normal"
        },
        {
          "index": 23,
          "type": "paragraph",
          "text": "ELSE CONVERT(VARCHAR(20), HCNCONTRDT.HCCFECTUR, 103)+' '+CONVERT(VARCHAR(8), HCNCONTRDT.HCCFECTUR, 114)",
          "style": "Normal"
        },
        {
          "index": 24,
          "type": "paragraph",
          "text": "END 'LLEGADA_PORTERO',",
          "style": "Normal"
        },
        {
          "index": 25,
          "type": "paragraph",
          "text": "HCNTRIAGE.HCTFECTRI AS 'FECHA_TRIAGE',",
          "style": "Normal"
        },
        {
          "index": 26,
          "type": "paragraph",
          "text": "CAST(ADNINGRESO.AINFECING AS DATE) AS 'FECHA_ADMISION',",
          "style": "Normal"
        },
        {
          "index": 27,
          "type": "paragraph",
          "text": "cast(FOL.HCFECFOLI as date) AS 'FECHA_FOLIO',",
          "style": "Normal"
        },
        {
          "index": 28,
          "type": "paragraph",
          "text": "CASE WHEN GEENENTADM.ENTNOMBRE LIKE '%NUEVA%' THEN 'NUEVA EPS'",
          "style": "Normal"
        },
        {
          "index": 29,
          "type": "paragraph",
          "text": "WHEN GEENENTADM.ENTNOMBRE LIKE '%SURA%' AND GEENENTADM.ENTNOMBRE NOT LIKE '%ARL SURA%' AND GEENENTADM.ENTNOMBRE NOT LIKE '%SEGUROS DE VIDA SURA%' AND GEENENTADM.ENTNOMBRE NOT LIKE '%SURAMERICANA%' THEN 'SURA'",
          "style": "Normal"
        },
        {
          "index": 30,
          "type": "paragraph",
          "text": "WHEN GEENENTADM.ENTNOMBRE LIKE '%SANITAS%' AND GEENENTADM.ENTNOMBRE NOT LIKE '%COLSANITAS%'",
          "style": "Normal"
        },
        {
          "index": 31,
          "type": "paragraph",
          "text": "AND GEENENTADM.ENTNOMBRE NOT LIKE '%MEDISANITAS%' THEN 'SANITAS'",
          "style": "Normal"
        },
        {
          "index": 32,
          "type": "paragraph",
          "text": "WHEN GEENENTADM.ENTNOMBRE LIKE '%MALLAMAS%' THEN 'MALLAMAS'",
          "style": "Normal"
        },
        {
          "index": 33,
          "type": "paragraph",
          "text": "ELSE GEENENTADM.ENTNOMBRE END AS 'AGRUPA_ASEGURADORA',",
          "style": "Normal"
        },
        {
          "index": 34,
          "type": "paragraph",
          "text": "GENDETCON.GDENOMBRE AS 'PLAN_BENEFICIO',",
          "style": "Normal"
        },
        {
          "index": 35,
          "type": "paragraph",
          "text": "CASE",
          "style": "Normal"
        },
        {
          "index": 36,
          "type": "paragraph",
          "text": "WHEN FOL.HCFECFOLI IS NULL THEN NULL",
          "style": "Normal"
        },
        {
          "index": 37,
          "type": "paragraph",
          "text": "WHEN HCNCLAURGTR.HCCODIGO = 'II'",
          "style": "Normal"
        },
        {
          "index": 38,
          "type": "paragraph",
          "text": "THEN DATEDIFF(MINUTE, ADNINGRESO.AINFECING, FOL.HCFECFOLI)",
          "style": "Normal"
        },
        {
          "index": 39,
          "type": "paragraph",
          "text": "WHEN HCTFECTRI IS NULL",
          "style": "Normal"
        },
        {
          "index": 40,
          "type": "paragraph",
          "text": "THEN DATEDIFF(MINUTE, ADNINGRESO.AINFECING, FOL.HCFECFOLI)",
          "style": "Normal"
        },
        {
          "index": 41,
          "type": "paragraph",
          "text": "ELSE DATEDIFF(MINUTE, HCNTRIAGE.HCTFECTRI, FOL.HCFECFOLI)",
          "style": "Normal"
        },
        {
          "index": 42,
          "type": "paragraph",
          "text": "END AS 'TIEMPO_CONSULTA_CALCULADA',",
          "style": "Normal"
        },
        {
          "index": 43,
          "type": "paragraph",
          "text": "CASE WHEN DATEDIFF(YEAR,GPAFECNAC,HCTFECTRI)<18 THEN 'MENORES' ELSE 'MAYORES' END 'MENORES_EDAD',",
          "style": "Normal"
        },
        {
          "index": 44,
          "type": "paragraph",
          "text": "GENTERCER.OID 'OID_TERCERO',",
          "style": "Normal"
        },
        {
          "index": 45,
          "type": "paragraph",
          "text": "GENTERCER.TERNOMCOM AS 'NOMB_TERCERO',",
          "style": "Normal"
        },
        {
          "index": 46,
          "type": "paragraph",
          "text": "CASE WHEN ADNINGRESO.AINCAUING = '1' THEN 'ENFERMEDAD_PROFESIONAL'",
          "style": "Normal"
        },
        {
          "index": 47,
          "type": "paragraph",
          "text": "WHEN ADNINGRESO.AINCAUING = '2' THEN 'HERIDOS_EN_COMBATE'",
          "style": "Normal"
        },
        {
          "index": 48,
          "type": "paragraph",
          "text": "WHEN ADNINGRESO.AINCAUING = '3' THEN 'ENFERMEDAD_GENERAL_ADULTO'",
          "style": "Normal"
        },
        {
          "index": 49,
          "type": "paragraph",
          "text": "WHEN ADNINGRESO.AINCAUING = '4' THEN 'ENFERMEDAD_GENERAL_PEDIATRIA'",
          "style": "Normal"
        },
        {
          "index": 50,
          "type": "paragraph",
          "text": "WHEN ADNINGRESO.AINCAUING = '6' THEN 'ACCIDENTE_DE_TRANSITO'",
          "style": "Normal"
        },
        {
          "index": 51,
          "type": "paragraph",
          "text": "WHEN ADNINGRESO.AINCAUING = '7' THEN 'CATASTROFE_FISALUD'",
          "style": "Normal"
        },
        {
          "index": 52,
          "type": "paragraph",
          "text": "WHEN ADNINGRESO.AINCAUING = '9' THEN 'MATERNIDAD'",
          "style": "Normal"
        },
        {
          "index": 53,
          "type": "paragraph",
          "text": "WHEN ADNINGRESO.AINCAUING = '10' THEN 'ACCIDENTE_LABORAL'",
          "style": "Normal"
        },
        {
          "index": 54,
          "type": "paragraph",
          "text": "WHEN ADNINGRESO.AINCAUING = '11' THEN 'CIRUGIA_PROGRAMADA' ELSE 'OTRA'",
          "style": "Normal"
        },
        {
          "index": 55,
          "type": "paragraph",
          "text": "END AS 'CAUSA_INGRESO',",
          "style": "Normal"
        },
        {
          "index": 56,
          "type": "paragraph",
          "text": "FOL.DIACODIGO,",
          "style": "Normal"
        },
        {
          "index": 57,
          "type": "paragraph",
          "text": "FOL.DIANOMBRE",
          "style": "Normal"
        },
        {
          "index": 58,
          "type": "paragraph",
          "text": "FROM DIM_INGRESO ADNINGRESO",
          "style": "Normal"
        },
        {
          "index": 59,
          "type": "paragraph",
          "text": "LEFT OUTER JOIN DIM_TRIAGE HCNTRIAGE ON HCNTRIAGE.OID = ADNINGRESO.HCENTRIAGE",
          "style": "Normal"
        },
        {
          "index": 60,
          "type": "paragraph",
          "text": "LEFT OUTER JOIN DIM_HCNCLAURGTR HCNCLAURGTR ON HCNTRIAGE.HCNCLAURGTR = HCNCLAURGTR.OID",
          "style": "Normal"
        },
        {
          "index": 61,
          "type": "paragraph",
          "text": "--LEFT OUTER JOIN DIM_DIAGNOSTICO GENDIAGNO ON ADNINGRESO.DGNDIAGNO = GENDIAGNO.OID",
          "style": "Normal"
        },
        {
          "index": 62,
          "type": "paragraph",
          "text": "LEFT OUTER JOIN DIM_HCNCONTRDT HCNCONTRDT ON HCNCONTRDT.OID = HCNTRIAGE.HCNCONTRDT",
          "style": "Normal"
        },
        {
          "index": 63,
          "type": "paragraph",
          "text": "LEFT OUTER JOIN DIM_ASEGURADORA GENDETCON ON ADNINGRESO.GENDETCON = GENDETCON.OID",
          "style": "Normal"
        },
        {
          "index": 64,
          "type": "paragraph",
          "text": "LEFT OUTER JOIN DIM_PACIENTES GENPACIEN ON GENPACIEN.OID = ADNINGRESO.GENPACIEN",
          "style": "Normal"
        },
        {
          "index": 65,
          "type": "paragraph",
          "text": "LEFT OUTER JOIN GENTERCER_DW GENTERCER ON GENDETCON.GENTERCER1=GENTERCER.OID",
          "style": "Normal"
        },
        {
          "index": 66,
          "type": "paragraph",
          "text": "LEFT OUTER JOIN DIM_ENTIDAD GEENENTADM ON GEENENTADM.OID = ADNINGRESO.GEENENTADM",
          "style": "Normal"
        },
        {
          "index": 67,
          "type": "paragraph",
          "text": "OUTER APPLY (",
          "style": "Normal"
        },
        {
          "index": 68,
          "type": "paragraph",
          "text": "SELECT TOP 1",
          "style": "Normal"
        },
        {
          "index": 69,
          "type": "paragraph",
          "text": "HCNFOLIO.HCNUMFOL,",
          "style": "Normal"
        },
        {
          "index": 70,
          "type": "paragraph",
          "text": "HCNFOLIO.HCFECFOLI,",
          "style": "Normal"
        },
        {
          "index": 71,
          "type": "paragraph",
          "text": "GENDIAGNO.DIACODIGO,",
          "style": "Normal"
        },
        {
          "index": 72,
          "type": "paragraph",
          "text": "GENDIAGNO.DIANOMBRE",
          "style": "Normal"
        },
        {
          "index": 73,
          "type": "paragraph",
          "text": "FROM DIM_FOLIO HCNFOLIO",
          "style": "Normal"
        },
        {
          "index": 74,
          "type": "paragraph",
          "text": "LEFT OUTER JOIN CONTROL_DIAGNOSTICO HCNDIAPAC ON HCNFOLIO.OID = HCNDIAPAC.HCNFOLIO",
          "style": "Normal"
        },
        {
          "index": 75,
          "type": "paragraph",
          "text": "LEFT OUTER JOIN DIM_DIAGNOSTICO GENDIAGNO ON GENDIAGNO.OID = HCNDIAPAC.GENDIAGNO",
          "style": "Normal"
        },
        {
          "index": 76,
          "type": "paragraph",
          "text": "WHERE HCNFOLIO.ADNINGRESO = ADNINGRESO.OID",
          "style": "Normal"
        },
        {
          "index": 77,
          "type": "paragraph",
          "text": "AND HCNDIAPAC.HCPDIAPRIN = '1'",
          "style": "Normal"
        },
        {
          "index": 78,
          "type": "paragraph",
          "text": "ORDER BY HCNFOLIO.HCFECFOLI ASC",
          "style": "Normal"
        },
        {
          "index": 79,
          "type": "paragraph",
          "text": ") FOL",
          "style": "Normal"
        },
        {
          "index": 80,
          "type": "paragraph",
          "text": "WHERE",
          "style": "Normal"
        },
        {
          "index": 81,
          "type": "paragraph",
          "text": "CAST(ADNINGRESO.AINFECING AS DATE) BETWEEN '2025-01-01' AND CAST(GETDATE() AS DATE)",
          "style": "Normal"
        },
        {
          "index": 82,
          "type": "paragraph",
          "text": "AND ADNINGRESO.AINESTADO not in ('2','4')",
          "style": "Normal"
        },
        {
          "index": 83,
          "type": "paragraph",
          "text": "AND ADNINGRESO.AINURGCON = '0'",
          "style": "Normal"
        },
        {
          "index": 84,
          "type": "paragraph",
          "text": "AND ADNINGRESO.AINCAUING NOT IN ('11', '4')",
          "style": "Normal"
        },
        {
          "index": 85,
          "type": "paragraph",
          "text": "--AND GEENENTADM.ENTNOMBRE in ('EPS SURA', 'NUEVA EMPRESA PROMOTORA DE SALUD EPS S.A.', 'NUEVA EPS PLANES COMPLEMENTARIOS', 'COLSANITAS S.A.','COLMEDICA MEDICINA PREPAGADA', 'FIDEICOMISOS PATRIMONIOS AUTONOMOS FIDUCIARIA LA PREVISORA S.A.')",
          "style": "Normal"
        },
        {
          "index": 86,
          "type": "paragraph",
          "text": "AND FOL.HCFECFOLI IS NOT NULL",
          "style": "Normal"
        },
        {
          "index": 87,
          "type": "paragraph",
          "text": "AND DATEDIFF(HOUR, ADNINGRESO.AINFECING, FOL.HCFECFOLI) <= 24",
          "style": "Normal"
        },
        {
          "index": 88,
          "type": "paragraph",
          "text": "AND (",
          "style": "Normal"
        },
        {
          "index": 89,
          "type": "paragraph",
          "text": "CASE",
          "style": "Normal"
        },
        {
          "index": 90,
          "type": "paragraph",
          "text": "WHEN FOL.HCFECFOLI IS NULL THEN NULL",
          "style": "Normal"
        },
        {
          "index": 91,
          "type": "paragraph",
          "text": "WHEN HCNCLAURGTR.HCCODIGO = 'II'",
          "style": "Normal"
        },
        {
          "index": 92,
          "type": "paragraph",
          "text": "THEN DATEDIFF(MINUTE, ADNINGRESO.AINFECING, FOL.HCFECFOLI)",
          "style": "Normal"
        },
        {
          "index": 93,
          "type": "paragraph",
          "text": "WHEN HCTFECTRI IS NULL",
          "style": "Normal"
        },
        {
          "index": 94,
          "type": "paragraph",
          "text": "THEN DATEDIFF(MINUTE, ADNINGRESO.AINFECING, FOL.HCFECFOLI)",
          "style": "Normal"
        },
        {
          "index": 95,
          "type": "paragraph",
          "text": "ELSE DATEDIFF(MINUTE, HCNTRIAGE.HCTFECTRI, FOL.HCFECFOLI)",
          "style": "Normal"
        },
        {
          "index": 96,
          "type": "paragraph",
          "text": "END",
          "style": "Normal"
        },
        {
          "index": 97,
          "type": "paragraph",
          "text": ") <= 1440",
          "style": "Normal"
        },
        {
          "index": 98,
          "type": "paragraph",
          "text": "--AND AINCONSEC = '2050553'",
          "style": "Normal"
        },
        {
          "index": 99,
          "type": "paragraph",
          "text": "AND ADNINGRESO.AIINGCORCU <> '1'",
          "style": "Normal"
        },
        {
          "index": 100,
          "type": "paragraph",
          "text": "--AND ADNINGRESO.AINTIPING = '1'",
          "style": "Normal"
        },
        {
          "index": 101,
          "type": "paragraph",
          "text": "ORDER BY 5",
          "style": "Normal"
        },
        {
          "index": 103,
          "type": "paragraph",
          "text": "DECRIPCION DE VISUALIZACIONES",
          "style": "Normal"
        },
        {
          "index": 104,
          "type": "paragraph",
          "text": "Tarjetas de filtro",
          "style": "Normal"
        },
        {
          "index": 105,
          "type": "paragraph",
          "text": "Muestran el filtrado de la información según la opción seleccionada en la clasificación de triage, asegurador, año, mes, día y rango de edad.",
          "style": "Normal"
        },
        {
          "index": 107,
          "type": "paragraph",
          "text": "Botones por área",
          "style": "Normal"
        },
        {
          "index": 108,
          "type": "paragraph",
          "text": "Realizan el filtrado de la información de acuerdo con el área seleccionada.",
          "style": "Normal"
        },
        {
          "index": 110,
          "type": "paragraph",
          "text": "Gráfico de Oportunidad de Consultas en Urgencias",
          "style": "Normal"
        },
        {
          "index": 111,
          "type": "paragraph",
          "text": "Representa el tiempo promedio mensual de la realización de consultas médicas en el área de urgencias durante los dos últimos años, importante para la medición de tiempos de servicio.",
          "style": "Normal"
        },
        {
          "index": 113,
          "type": "paragraph",
          "text": "Tabla de Oportunidad de Consultas en Urgencias",
          "style": "Normal"
        },
        {
          "index": 114,
          "type": "paragraph",
          "text": "Representa el tiempo promedio mensual de la realización de consultas médicas en el área de urgencias durante los dos últimos años, importante para la medición de tiempos de servicio.",
          "style": "Normal"
        }
      ]
    }
  ]
}