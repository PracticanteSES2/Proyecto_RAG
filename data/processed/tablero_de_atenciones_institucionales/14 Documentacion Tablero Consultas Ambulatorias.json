    {
      "name": "CONSULTAS AMBULATORIAS",
      "source_file": "14 Documentacion Tablero Consultas Ambulatorias.docx",
      "blocks": [
        {
          "index": 1,
          "type": "paragraph",
          "text": "Este tablero permite analizar el comportamiento de las consultas ambulatorias realizadas en la institución, facilitando el seguimiento del volumen de consultas, su evolución mensual y los tiempos de oportunidad de atención.",
          "style": "Normal"
        },
        {
          "index": 3,
          "type": "paragraph",
          "text": "PARA CREAR ESTE TABLERO SE UTILIZO LA SIGUIENTE CONSULTA",
          "style": "Normal"
        },
        {
          "index": 4,
          "type": "paragraph",
          "text": "CONSULTAS_AMBULATORIAS",
          "style": "Normal"
        },
        {
          "index": 5,
          "type": "paragraph",
          "text": ";WITH CTE AS (",
          "style": "Normal"
        },
        {
          "index": 6,
          "type": "paragraph",
          "text": "SELECT",
          "style": "Normal"
        },
        {
          "index": 7,
          "type": "paragraph",
          "text": "CMNCITMED.OID AS OID_CITA,",
          "style": "Normal"
        },
        {
          "index": 8,
          "type": "paragraph",
          "text": "GENDETCON.GDENOMBRE COLLATE DATABASE_DEFAULT AS ASEGURADOR,",
          "style": "Normal"
        },
        {
          "index": 10,
          "type": "paragraph",
          "text": "CASE",
          "style": "Normal"
        },
        {
          "index": 11,
          "type": "paragraph",
          "text": "WHEN GENESPECI.GEEDESCRI LIKE '%HEMATOLOGIA%' THEN 'HEMATOLOGIA'",
          "style": "Normal"
        },
        {
          "index": 12,
          "type": "paragraph",
          "text": "WHEN GENESPECI.GEEDESCRI LIKE '%CUIDADO PALIATIVO%' THEN 'CUIDADO PALIATIVO'",
          "style": "Normal"
        },
        {
          "index": 13,
          "type": "paragraph",
          "text": "WHEN GENESPECI.GEEDESCRI LIKE '%MEDICINA INTERNA Y GERIATRIA%' THEN 'GERIATRIA'",
          "style": "Normal"
        },
        {
          "index": 14,
          "type": "paragraph",
          "text": "WHEN GENESPECI.GEEDESCRI = 'GERIATRIA' THEN 'GERIATRIA'",
          "style": "Normal"
        },
        {
          "index": 15,
          "type": "paragraph",
          "text": "WHEN GENESPECI.GEEDESCRI LIKE '%MEDICINA INTERNA Y NEUMOLOGIA%' THEN 'NEUMOLOGIA'",
          "style": "Normal"
        },
        {
          "index": 16,
          "type": "paragraph",
          "text": "WHEN CMNTIPACT.CMANOMBRE LIKE '%ESPIROMETRIA%' THEN 'REHABILITACION PULMONAR'",
          "style": "Normal"
        },
        {
          "index": 17,
          "type": "paragraph",
          "text": "WHEN CMNTIPACT.CMANOMBRE LIKE '%CAPACIDAD DE DIFUSION CON MONOXIDO DE CARBONO%' THEN 'REHABILITACION PULMONAR'",
          "style": "Normal"
        },
        {
          "index": 18,
          "type": "paragraph",
          "text": "WHEN CMNTIPACT.CMANOMBRE LIKE '%REHABILITACION PULMONAR%' THEN 'REHABILITACION PULMONAR'",
          "style": "Normal"
        },
        {
          "index": 19,
          "type": "paragraph",
          "text": "WHEN CMNTIPACT.CMANOMBRE LIKE '%TEST DE CAMINATA%' THEN 'REHABILITACION CARDIACA'",
          "style": "Normal"
        },
        {
          "index": 20,
          "type": "paragraph",
          "text": "WHEN CMNTIPACT.CMANOMBRE LIKE '%REHABILITACION CARDIACA%' THEN 'REHABILITACION CARDIACA'",
          "style": "Normal"
        },
        {
          "index": 21,
          "type": "paragraph",
          "text": "WHEN CMNTIPACT.CMANOMBRE LIKE 'OBST' THEN 'OBSTETRICIA'",
          "style": "Normal"
        },
        {
          "index": 22,
          "type": "paragraph",
          "text": "WHEN DATEDIFF(YEAR, GPAFECNAC, CMNCITMED.CCMFECCIT) < 2 THEN 'CANGURO'",
          "style": "Normal"
        },
        {
          "index": 23,
          "type": "paragraph",
          "text": "WHEN GENESPECI.GEEDESCRI = 'ANESTESIOLOGIA'",
          "style": "Normal"
        },
        {
          "index": 24,
          "type": "paragraph",
          "text": "AND GENMEDICO.GMENOMCOM IN ('OROZCO ARANGO JAIME ANDRES','ORTIZ GOMEZ GUILLERMO ALBERTO')",
          "style": "Normal"
        },
        {
          "index": 25,
          "type": "paragraph",
          "text": "THEN 'CLINICA DEL DOLOR'",
          "style": "Normal"
        },
        {
          "index": 26,
          "type": "paragraph",
          "text": "WHEN GENESPECI.GEEDESCRI = 'ANESTESIOLOGIA'",
          "style": "Normal"
        },
        {
          "index": 27,
          "type": "paragraph",
          "text": "AND GENMEDICO.GMENOMCOM NOT IN ('OROZCO ARANGO JAIME ANDRES','ORTIZ GOMEZ GUILLERMO ALBERTO')",
          "style": "Normal"
        },
        {
          "index": 28,
          "type": "paragraph",
          "text": "THEN 'CHEQUEO PRE-ANESTESICO'",
          "style": "Normal"
        },
        {
          "index": 29,
          "type": "paragraph",
          "text": "WHEN GENESPECI.GEEDESCRI = 'GASTROENTEROLOGIA'",
          "style": "Normal"
        },
        {
          "index": 30,
          "type": "paragraph",
          "text": "AND CMNTIPACT.CMANOMBRE LIKE '%CONSULTA%' THEN 'GASTROENTEROLOGIA'",
          "style": "Normal"
        },
        {
          "index": 31,
          "type": "paragraph",
          "text": "WHEN GENESPECI.GEEDESCRI = 'GASTROENTEROLOGIA'",
          "style": "Normal"
        },
        {
          "index": 32,
          "type": "paragraph",
          "text": "AND CMNTIPACT.CMANOMBRE NOT LIKE '%CONSULTA%' THEN 'GASTROENTEROLOGIA_QUITAR'",
          "style": "Normal"
        },
        {
          "index": 33,
          "type": "paragraph",
          "text": "ELSE GENESPECI.GEEDESCRI",
          "style": "Normal"
        },
        {
          "index": 34,
          "type": "paragraph",
          "text": "END COLLATE DATABASE_DEFAULT AS ESPECIALIDAD,",
          "style": "Normal"
        },
        {
          "index": 36,
          "type": "paragraph",
          "text": "GENMEDICO.GMENOMCOM COLLATE DATABASE_DEFAULT AS MEDICO,",
          "style": "Normal"
        },
        {
          "index": 37,
          "type": "paragraph",
          "text": "GENPACIEN.PACNUMDOC COLLATE DATABASE_DEFAULT AS IDENTIFICACION,",
          "style": "Normal"
        },
        {
          "index": 38,
          "type": "paragraph",
          "text": "CMNCITMED.CCMPACNOM COLLATE DATABASE_DEFAULT AS PACIENTE,",
          "style": "Normal"
        },
        {
          "index": 39,
          "type": "paragraph",
          "text": "CMNCITMED.CCMFECASI AS FECHA_ASIGNA_CITA,",
          "style": "Normal"
        },
        {
          "index": 40,
          "type": "paragraph",
          "text": "CMNCITMED.CCMFECCIT AS FECHA_CITA,",
          "style": "Normal"
        },
        {
          "index": 41,
          "type": "paragraph",
          "text": "HCNFOLIO.HCFECFOLI AS FECHA_ABRE_FOLIO,",
          "style": "Normal"
        },
        {
          "index": 42,
          "type": "paragraph",
          "text": "DATEDIFF(DAY, CMNCITMED.CCMFECASI, CMNCITMED.CCMFECCIT) AS DIAS,",
          "style": "Normal"
        },
        {
          "index": 43,
          "type": "paragraph",
          "text": "CAST(CMNCITMED.CCMFECCIT AS DATE) AS FECHA,",
          "style": "Normal"
        },
        {
          "index": 45,
          "type": "paragraph",
          "text": "CASE",
          "style": "Normal"
        },
        {
          "index": 46,
          "type": "paragraph",
          "text": "WHEN GENPACIEN.PACTIPDOC = 1 THEN 'CC'",
          "style": "Normal"
        },
        {
          "index": 47,
          "type": "paragraph",
          "text": "WHEN GENPACIEN.PACTIPDOC = 2 THEN 'CE'",
          "style": "Normal"
        },
        {
          "index": 48,
          "type": "paragraph",
          "text": "WHEN GENPACIEN.PACTIPDOC = 3 THEN 'TI'",
          "style": "Normal"
        },
        {
          "index": 49,
          "type": "paragraph",
          "text": "WHEN GENPACIEN.PACTIPDOC = 4 THEN 'RC'",
          "style": "Normal"
        },
        {
          "index": 50,
          "type": "paragraph",
          "text": "WHEN GENPACIEN.PACTIPDOC = 5 THEN 'PA'",
          "style": "Normal"
        },
        {
          "index": 51,
          "type": "paragraph",
          "text": "WHEN GENPACIEN.PACTIPDOC = 6 THEN 'AS'",
          "style": "Normal"
        },
        {
          "index": 52,
          "type": "paragraph",
          "text": "WHEN GENPACIEN.PACTIPDOC = 7 THEN 'MS'",
          "style": "Normal"
        },
        {
          "index": 53,
          "type": "paragraph",
          "text": "WHEN GENPACIEN.PACTIPDOC = 8 THEN 'CC'",
          "style": "Normal"
        },
        {
          "index": 54,
          "type": "paragraph",
          "text": "WHEN GENPACIEN.PACTIPDOC = 9 THEN 'SC'",
          "style": "Normal"
        },
        {
          "index": 55,
          "type": "paragraph",
          "text": "WHEN GENPACIEN.PACTIPDOC = 10 THEN 'CN'",
          "style": "Normal"
        },
        {
          "index": 56,
          "type": "paragraph",
          "text": "WHEN GENPACIEN.PACTIPDOC = 11 THEN 'CD'",
          "style": "Normal"
        },
        {
          "index": 57,
          "type": "paragraph",
          "text": "WHEN GENPACIEN.PACTIPDOC = 12 THEN 'PT'",
          "style": "Normal"
        },
        {
          "index": 58,
          "type": "paragraph",
          "text": "WHEN GENPACIEN.PACTIPDOC = 14 THEN 'PE'",
          "style": "Normal"
        },
        {
          "index": 59,
          "type": "paragraph",
          "text": "END COLLATE DATABASE_DEFAULT AS TIPO_IDENT,",
          "style": "Normal"
        },
        {
          "index": 61,
          "type": "paragraph",
          "text": "CMNTIPACT.CMANOMBRE COLLATE DATABASE_DEFAULT AS TIPO_ATENCION,",
          "style": "Normal"
        },
        {
          "index": 63,
          "type": "paragraph",
          "text": "CASE",
          "style": "Normal"
        },
        {
          "index": 64,
          "type": "paragraph",
          "text": "WHEN HCM0CONEX.HCCM09N13 IS NULL",
          "style": "Normal"
        },
        {
          "index": 65,
          "type": "paragraph",
          "text": "AND CMNTIPACT.CMANOMBRE LIKE '%PRIMERA VEZ%' THEN 'Primera Vez'",
          "style": "Normal"
        },
        {
          "index": 66,
          "type": "paragraph",
          "text": "WHEN HCM0CONEX.HCCM09N13 IS NULL",
          "style": "Normal"
        },
        {
          "index": 67,
          "type": "paragraph",
          "text": "AND CMNTIPACT.CMANOMBRE NOT LIKE '%PRIMERA VEZ%' THEN 'Control'",
          "style": "Normal"
        },
        {
          "index": 68,
          "type": "paragraph",
          "text": "ELSE HCM0CONEX.HCCM09N13",
          "style": "Normal"
        },
        {
          "index": 69,
          "type": "paragraph",
          "text": "END COLLATE DATABASE_DEFAULT AS PV_CONTROL,",
          "style": "Normal"
        },
        {
          "index": 71,
          "type": "paragraph",
          "text": "CASE",
          "style": "Normal"
        },
        {
          "index": 72,
          "type": "paragraph",
          "text": "WHEN CMNCITMED.CCMESTADO = '0' THEN 'ASIGNADA'",
          "style": "Normal"
        },
        {
          "index": 73,
          "type": "paragraph",
          "text": "WHEN CMNCITMED.CCMESTADO = '1' THEN 'CANCELADA'",
          "style": "Normal"
        },
        {
          "index": 74,
          "type": "paragraph",
          "text": "WHEN CMNCITMED.CCMESTADO = '2' THEN 'CUMPLIDA'",
          "style": "Normal"
        },
        {
          "index": 75,
          "type": "paragraph",
          "text": "WHEN CMNCITMED.CCMESTADO = '3' THEN 'INCUMPLIDA'",
          "style": "Normal"
        },
        {
          "index": 76,
          "type": "paragraph",
          "text": "WHEN CMNCITMED.CCMESTADO = '4' THEN 'FACTURADA'",
          "style": "Normal"
        },
        {
          "index": 77,
          "type": "paragraph",
          "text": "WHEN CMNCITMED.CCMESTADO = '5' THEN 'INATENCION'",
          "style": "Normal"
        },
        {
          "index": 78,
          "type": "paragraph",
          "text": "END COLLATE DATABASE_DEFAULT AS ESTADO_CITA,",
          "style": "Normal"
        },
        {
          "index": 80,
          "type": "paragraph",
          "text": "GENTERCER_DW.TERNOMCOM COLLATE DATABASE_DEFAULT AS TERNOMCOM,",
          "style": "Normal"
        },
        {
          "index": 81,
          "type": "paragraph",
          "text": "GPAFECNAC,",
          "style": "Normal"
        },
        {
          "index": 83,
          "type": "paragraph",
          "text": "ROW_NUMBER() OVER (",
          "style": "Normal"
        },
        {
          "index": 84,
          "type": "paragraph",
          "text": "PARTITION BY",
          "style": "Normal"
        },
        {
          "index": 85,
          "type": "paragraph",
          "text": "GENDETCON.GDENOMBRE,",
          "style": "Normal"
        },
        {
          "index": 86,
          "type": "paragraph",
          "text": "GENESPECI.GEEDESCRI,",
          "style": "Normal"
        },
        {
          "index": 87,
          "type": "paragraph",
          "text": "GENPACIEN.PACNUMDOC,",
          "style": "Normal"
        },
        {
          "index": 88,
          "type": "paragraph",
          "text": "CMNCITMED.CCMFECCIT",
          "style": "Normal"
        },
        {
          "index": 89,
          "type": "paragraph",
          "text": "ORDER BY HCNFOLIO.HCFECFOLI DESC",
          "style": "Normal"
        },
        {
          "index": 90,
          "type": "paragraph",
          "text": ") AS RN",
          "style": "Normal"
        },
        {
          "index": 91,
          "type": "paragraph",
          "text": "FROM CITAS_MEDICAS CMNCITMED",
          "style": "Normal"
        },
        {
          "index": 92,
          "type": "paragraph",
          "text": "LEFT JOIN DIM_FOLIO HCNFOLIO",
          "style": "Normal"
        },
        {
          "index": 93,
          "type": "paragraph",
          "text": "ON CMNCITMED.GENPACIEN = HCNFOLIO.GENPACIEN",
          "style": "Normal"
        },
        {
          "index": 94,
          "type": "paragraph",
          "text": "AND CAST(CMNCITMED.CCMFECCIT AS DATE) = CAST(HCNFOLIO.HCFECFOL AS DATE)",
          "style": "Normal"
        },
        {
          "index": 95,
          "type": "paragraph",
          "text": "AND (CMNCITMED.GENMEDICO1 = HCNFOLIO.GENMEDICO",
          "style": "Normal"
        },
        {
          "index": 96,
          "type": "paragraph",
          "text": "OR CMNCITMED.GENESPECI = HCNFOLIO.GENESPECI)",
          "style": "Normal"
        },
        {
          "index": 97,
          "type": "paragraph",
          "text": "INNER JOIN DIM_PACIENTES GENPACIEN ON GENPACIEN.OID = CMNCITMED.GENPACIEN",
          "style": "Normal"
        },
        {
          "index": 98,
          "type": "paragraph",
          "text": "INNER JOIN DIM_MEDICO GENMEDICO ON GENMEDICO.OID = CMNCITMED.GENMEDICO1",
          "style": "Normal"
        },
        {
          "index": 99,
          "type": "paragraph",
          "text": "INNER JOIN DIM_ESPECIALIDAD GENESPECI ON GENESPECI.OID = CMNCITMED.GENESPECI",
          "style": "Normal"
        },
        {
          "index": 100,
          "type": "paragraph",
          "text": "INNER JOIN CMNTIPACT ON CMNCITMED.CMNTIPACT = CMNTIPACT.OID",
          "style": "Normal"
        },
        {
          "index": 101,
          "type": "paragraph",
          "text": "LEFT JOIN DIM_ASEGURADORA GENDETCON ON GENDETCON.OID = GENPACIEN.GENDETCON",
          "style": "Normal"
        },
        {
          "index": 102,
          "type": "paragraph",
          "text": "LEFT JOIN [172.16.104.10\\DINAMICA].DGEMPRES10.DBO.HCM0CONEX",
          "style": "Normal"
        },
        {
          "index": 103,
          "type": "paragraph",
          "text": "ON HCNFOLIO.OID = HCM0CONEX.HCNFOLIO",
          "style": "Normal"
        },
        {
          "index": 104,
          "type": "paragraph",
          "text": "LEFT JOIN GENTERCER_DW",
          "style": "Normal"
        },
        {
          "index": 105,
          "type": "paragraph",
          "text": "ON GENDETCON.GENTERCER1 = GENTERCER_DW.OID",
          "style": "Normal"
        },
        {
          "index": 106,
          "type": "paragraph",
          "text": "WHERE",
          "style": "Normal"
        },
        {
          "index": 107,
          "type": "paragraph",
          "text": "CAST(CMNCITMED.CCMFECCIT AS DATE) BETWEEN '2025-11-01' AND CAST(GETDATE() AS DATE)",
          "style": "Normal"
        },
        {
          "index": 108,
          "type": "paragraph",
          "text": "AND GENESPECI.OID NOT IN ('1','2','3','4','6','8','51','65','88','90','129')",
          "style": "Normal"
        },
        {
          "index": 109,
          "type": "paragraph",
          "text": "AND HCNFOLIO.HCFECFOLI IS NOT NULL",
          "style": "Normal"
        },
        {
          "index": 110,
          "type": "paragraph",
          "text": "AND CMNCITMED.CCMESTADO <> '1'",
          "style": "Normal"
        },
        {
          "index": 111,
          "type": "paragraph",
          "text": "AND CMNTIPACT.CMANOMBRE NOT LIKE '%PRIORI%'",
          "style": "Normal"
        },
        {
          "index": 112,
          "type": "paragraph",
          "text": ")",
          "style": "Normal"
        },
        {
          "index": 114,
          "type": "paragraph",
          "text": "SELECT DISTINCT",
          "style": "Normal"
        },
        {
          "index": 115,
          "type": "paragraph",
          "text": "0 AS OID_CITA,",
          "style": "Normal"
        },
        {
          "index": 116,
          "type": "paragraph",
          "text": "A.ASEGURADOR COLLATE DATABASE_DEFAULT AS ASEGURADOR,",
          "style": "Normal"
        },
        {
          "index": 117,
          "type": "paragraph",
          "text": "CASE WHEN A.ESPECIALIDAD IN ('CHEQUEO ANESTESIA ','CHEQUEO ANESTESIA ','CHEQUEO ANESTESIOLOGIA ','CHEQUEO ANESTESIA',",
          "style": "Normal"
        },
        {
          "index": 118,
          "type": "paragraph",
          "text": "'CHEQUEOS ANESTESIOLOGIA ','CHEQUEO ANESTESIA ','CHEQUEO ANESTESIOLOGIA ','CHEQUEO ANESTESICO','CHEQUEOS ANESTESIA','CHEQUEO ANESTESIA ')THEN 'CHEQUEO ANESTESIOLOGIA' ELSE ESPECIALIDAD END AS ESPECIALIDAD,",
          "style": "Normal"
        },
        {
          "index": 119,
          "type": "paragraph",
          "text": "A.MEDICO COLLATE DATABASE_DEFAULT AS MEDICO,",
          "style": "Normal"
        },
        {
          "index": 120,
          "type": "paragraph",
          "text": "A.IDENTIFICACION COLLATE DATABASE_DEFAULT AS IDENTIFICACION,",
          "style": "Normal"
        },
        {
          "index": 121,
          "type": "paragraph",
          "text": "A.PACIENTE COLLATE DATABASE_DEFAULT AS PACIENTE,",
          "style": "Normal"
        },
        {
          "index": 122,
          "type": "paragraph",
          "text": "A.FECHA_ASIGNA_CITA AS FECHA_ASIGNA_CITA,",
          "style": "Normal"
        },
        {
          "index": 123,
          "type": "paragraph",
          "text": "A.FECHA_CITA AS FECHA_CITA,",
          "style": "Normal"
        },
        {
          "index": 124,
          "type": "paragraph",
          "text": "NULL AS FECHA_ABRE_FOLIO,",
          "style": "Normal"
        },
        {
          "index": 125,
          "type": "paragraph",
          "text": "A.DIAS,",
          "style": "Normal"
        },
        {
          "index": 126,
          "type": "paragraph",
          "text": "A.FECHA_CITA,",
          "style": "Normal"
        },
        {
          "index": 127,
          "type": "paragraph",
          "text": "A.TIPO_IDENT COLLATE DATABASE_DEFAULT AS TIPO_IDENT,",
          "style": "Normal"
        },
        {
          "index": 128,
          "type": "paragraph",
          "text": "A.TIPO_ATENCION COLLATE DATABASE_DEFAULT AS TIPO_ATENCION,",
          "style": "Normal"
        },
        {
          "index": 129,
          "type": "paragraph",
          "text": "A.PV_CONTROL COLLATE DATABASE_DEFAULT AS PV_CONTROL,",
          "style": "Normal"
        },
        {
          "index": 130,
          "type": "paragraph",
          "text": "A.ESTADO_CITA COLLATE DATABASE_DEFAULT AS ESTADO_CITA,",
          "style": "Normal"
        },
        {
          "index": 131,
          "type": "paragraph",
          "text": "D.TERNOMCOM COLLATE DATABASE_DEFAULT AS TERNOMCOM,",
          "style": "Normal"
        },
        {
          "index": 132,
          "type": "paragraph",
          "text": "NULL AS GPAFECNAC,",
          "style": "Normal"
        },
        {
          "index": 133,
          "type": "paragraph",
          "text": "NULL AS RN",
          "style": "Normal"
        },
        {
          "index": 134,
          "type": "paragraph",
          "text": "FROM AT_AMB_MAYO_2025 A",
          "style": "Normal"
        },
        {
          "index": 135,
          "type": "paragraph",
          "text": "LEFT JOIN DIM_PACIENTES B",
          "style": "Normal"
        },
        {
          "index": 136,
          "type": "paragraph",
          "text": "ON A.IDENTIFICACION COLLATE DATABASE_DEFAULT = B.PACNUMDOC COLLATE DATABASE_DEFAULT",
          "style": "Normal"
        },
        {
          "index": 137,
          "type": "paragraph",
          "text": "LEFT JOIN DIM_ASEGURADORA C",
          "style": "Normal"
        },
        {
          "index": 138,
          "type": "paragraph",
