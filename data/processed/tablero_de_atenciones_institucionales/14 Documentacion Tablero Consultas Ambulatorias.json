        {
          "type": "table",
          "rows": [
            [
              "Tabla",
              "Nombre Medida",
              "DAX"
            ],
            [
              "Calendario",
              "Proyeccion_Amb",
              "Proyeccion_Amb = \nVAR MostrarFiltro = SELECTEDVALUE(MostrarProyeccion[Opcion], \"NO\")\nVAR AnnoSeleccionado = \n IF(\n ISFILTERED('Calendario'[Año]), \n SELECTEDVALUE('Calendario'[Año]), \n YEAR(TODAY())\n )\n\nVAR MesContexto = SELECTEDVALUE('Calendario'[Mes]) \nVAR AnnoAnterior = \n CALCULATE(\n COUNT(CONSULTAS_AMBULATORIAS[IDENTIFICACION]),\n CONSULTAS_AMBULATORIAS[ESTADO_CITA] = \"CUMPLIDA\",\n CONSULTAS_AMBULATORIAS[ESPECIALIDAD] <> \"GASTROENTEROLOGIA_QUITAR\",\n 'Calendario'[Año] = AnnoSeleccionado - 1, 'Calendario'[Mes] = MesContexto,\n REMOVEFILTERS('Calendario'[Año]) -- Permite buscar el año - 1 aunque el filtro diga \"2024\"\n )\nVAR AnnTrasAnterior = \n CALCULATE(\n [total_amb], \n 'Calendario'[Año] = AnnoSeleccionado - 2, 'Calendario'[Mes] = MesContexto,\n REMOVEFILTERS('Calendario'[Año])\n )\nVAR VariacionPorcentual = DIVIDE((AnnoAnterior - AnnTrasAnterior), AnnTrasAnterior, 0)\nVAR Resultado = AnnoAnterior * (1 + VariacionPorcentual)\nRETURN\n IF(\n MostrarFiltro = \"SI\" && NOT(ISBLANK(AnnoAnterior)), \n Resultado, \n BLANK()\n )"
            ],
            [
              "CONSULTAS_AMBULATORIAS",
              "promedio_asignacion",
              "AVERAGE(CONSULTAS_AMBULATORIAS[DIAS_REAL])"
            ],
            [
              "CONSULTAS_AMBULATORIAS",
              "Promedio_Tiempo_Dinamico",
              "VAR MesSeleccionado = ISFILTERED('Calendario'[Date]) || ISFILTERED('Calendario'[Mes]) -- Detecta si hay filtros activos\nVAR UltimaFechaConDatos = CALCULATE(MAX('CONSULTAS_AMBULATORIAS'[FECHA_CITA]), ALL('CONSULTAS_AMBULATORIAS')) -- Busca la última consulta real\nVAR UltimoMesCerrado = MONTH(UltimaFechaConDatos)\nVAR AnioUltimoMes = YEAR(UltimaFechaConDatos)\n\nRETURN\nIF(\nMesSeleccionado,\n[promedio_asignacion], -- Si el usuario filtra, muestra el promedio del filtro\nCALCULATE(\n[promedio_asignacion], \nMONTH('Calendario'[Date]) = UltimoMesCerrado,\nYEAR('Calendario'[Date]) = AnioUltimoMes\n) -- Si no hay filtro, muestra el último mes con datos\n)"
            ],
            [
              "CONSULTAS_AMBULATORIAS",
              "Promedio_Dinamico",
              "VAR FiltroActivo = ISFILTERED('Calendario'[Date]) || ISFILTERED('Calendario'[Date].[Mes]) && ISFILTERED('Calendario'[Date].[Año])\nVAR Hoy = TODAY() \nVAR PrimerDiaMesActual = DATE(YEAR(Hoy), MONTH(Hoy), 1) \nVAR UltimoDiaMesCerrado = PrimerDiaMesActual - 1 \nVAR MesCerrado = MONTH(UltimoDiaMesCerrado) \nVAR AnioCerrado = YEAR(UltimoDiaMesCerrado)\nRETURN IF( FiltroActivo, [promedio_asignacion], CALCULATE( [promedio_asignacion], MONTH('Calendario'[Date]) = MesCerrado, YEAR('Calendario'[Date]) = AnioCerrado ) )"
            ],
            [
              "CONSULTAS_AMBULATORIAS",
              "AMB_ANT",
              "CALCULATE(\nCOUNT(CONSULTAS_AMBULATORIAS[OID_CITA]),\nYEAR(CONSULTAS_AMBULATORIAS[FECHA_CITA])=YEAR(TODAY())-1)"
            ],
            [
              "CONSULTAS_AMBULATORIAS",
              "AMB_ACT",
              "CALCULATE(\nCOUNT(CONSULTAS_AMBULATORIAS[OID_CITA]),\nYEAR(CONSULTAS_AMBULATORIAS[FECHA_CITA])=YEAR(TODAY()))"
            ]
          ],
