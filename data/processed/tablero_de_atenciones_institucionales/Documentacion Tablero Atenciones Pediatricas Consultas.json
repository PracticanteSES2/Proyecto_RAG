  "semantic_model_key": "tablero_de_atenciones_institucionales",
  "semantic_model": "TABLERO DE ATENCIONES INSTITUCIONALES",
  "document_group": null,
  "dashboards": [
    {
      "name": "ATENCIONES PEDIÁTRICAS – CONSULTAS",
      "source_file": "Documentacion Tablero Atenciones Pediatricas Consultas.docx",
      "blocks": [
        {
          "index": 1,
          "type": "paragraph",
          "text": "Este tablero permite analizar el comportamiento de las consultas pediátricas atendidas en urgencias, visualizando su evolución mensual y su distribución según la clasificación del triage.",
          "style": "Normal"
        },
        {
          "index": 4,
          "type": "paragraph",
          "text": "PARA CREAR ESTE TABLERO SE UTILIZO LA SIGUIENTE CONSULTA",
          "style": "Normal"
        },
        {
          "index": 5,
          "type": "paragraph",
          "text": "SELECT DIM_TRIAGE.OID AS 'OID_TRIAGE', DIM_TRIAGE.GPADOCUME AS DOCUMENTO,",
          "style": "Normal"
        },
        {
          "index": 6,
          "type": "paragraph",
          "text": "CASE WHEN DIM_HCNCLAURGTR.HCCODIGO = 'I' THEN 'I'",
          "style": "Normal"
        },
        {
          "index": 7,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'I-G' THEN 'EMERGENCIA OBSTETRICA - I-G'",
          "style": "Normal"
        },
        {
          "index": 8,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'II' THEN 'II'",
          "style": "Normal"
        },
        {
          "index": 9,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'II-G' THEN 'URGENCIA MEDICA OBSTETRICA - II-G'",
          "style": "Normal"
        },
        {
          "index": 10,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'III' THEN 'III'",
          "style": "Normal"
        },
        {
          "index": 11,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'III-G' THEN 'URGENCIA OBSTETRICA - III-G'",
          "style": "Normal"
        },
        {
          "index": 12,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'IIIU' THEN 'III'",
          "style": "Normal"
        },
        {
          "index": 13,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'IIP' THEN 'II'",
          "style": "Normal"
        },
        {
          "index": 14,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'IIS' THEN 'II'",
          "style": "Normal"
        },
        {
          "index": 15,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'IV' THEN 'IV'",
          "style": "Normal"
        },
        {
          "index": 16,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'IV-G' THEN 'NO URGENTE OBSTETRICA - IV-G'",
          "style": "Normal"
        },
        {
          "index": 17,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'M' THEN 'MUERTO'",
          "style": "Normal"
        },
        {
          "index": 18,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'V' THEN 'V'",
          "style": "Normal"
        },
        {
          "index": 19,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'V-G' THEN 'CONSULTA EXTERNA OBSTETRICA - V-G'",
          "style": "Normal"
        },
        {
          "index": 20,
          "type": "paragraph",
          "text": "END 'TIPO_TRIAGE',",
          "style": "Normal"
        },
        {
          "index": 21,
          "type": "paragraph",
          "text": "CASE WHEN DIM_HCNCLAURGTR.HCCODIGO = 'I' THEN 'I'",
          "style": "Normal"
        },
        {
          "index": 22,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'I-G' THEN 'I-G'",
          "style": "Normal"
        },
        {
          "index": 23,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'II' THEN 'II'",
          "style": "Normal"
        },
        {
          "index": 24,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'II-G' THEN 'II-G'",
          "style": "Normal"
        },
        {
          "index": 25,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'III' THEN 'III'",
          "style": "Normal"
        },
        {
          "index": 26,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'III-G' THEN 'III-G'",
          "style": "Normal"
        },
        {
          "index": 27,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'IIIU' THEN 'III'",
          "style": "Normal"
        },
        {
          "index": 28,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'IIP' THEN 'II'",
          "style": "Normal"
        },
        {
          "index": 29,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'IIS' THEN 'II'",
          "style": "Normal"
        },
        {
          "index": 30,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'IV' THEN 'IV'",
          "style": "Normal"
        },
        {
          "index": 31,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'IV-G' THEN 'IV-G'",
          "style": "Normal"
        },
        {
          "index": 32,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'M' THEN 'MUERTO'",
          "style": "Normal"
        },
        {
          "index": 33,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'V' THEN 'V'",
          "style": "Normal"
        },
        {
          "index": 34,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCLAURGTR.HCCODIGO = 'V-G' THEN 'V-G'",
          "style": "Normal"
        },
        {
          "index": 35,
          "type": "paragraph",
          "text": "END 'CLASIFICACION_TRIAGE',",
          "style": "Normal"
        },
        {
          "index": 36,
          "type": "paragraph",
          "text": "DIM_TRIAGE.GPANOMBRE AS NOM1,",
          "style": "Normal"
        },
        {
          "index": 37,
          "type": "paragraph",
          "text": "DIM_TRIAGE.GPASEGNOM AS NOM2,",
          "style": "Normal"
        },
        {
          "index": 38,
          "type": "paragraph",
          "text": "DIM_TRIAGE.GPAAPELLI AS NOM3,",
          "style": "Normal"
        },
        {
          "index": 39,
          "type": "paragraph",
          "text": "DIM_TRIAGE.GPASEGAPE AS NOM4,",
          "style": "Normal"
        },
        {
          "index": 40,
          "type": "paragraph",
          "text": "DIM_ENTIDAD.ENTNOMBRE,",
          "style": "Normal"
        },
        {
          "index": 41,
          "type": "paragraph",
          "text": "CASE",
          "style": "Normal"
        },
        {
          "index": 42,
          "type": "paragraph",
          "text": "WHEN DIM_HCNCONTRDT.HCCFECTUR IS NULL THEN CONVERT(VARCHAR(20), HCTFECTRI, 103)+' '+CONVERT(VARCHAR(8), HCTFECTRI, 114)",
          "style": "Normal"
        },
        {
          "index": 43,
          "type": "paragraph",
          "text": "ELSE CONVERT(VARCHAR(20), DIM_HCNCONTRDT.HCCFECTUR, 103)+' '+CONVERT(VARCHAR(8), DIM_HCNCONTRDT.HCCFECTUR, 114)",
          "style": "Normal"
        },
        {
          "index": 44,
          "type": "paragraph",
          "text": "END 'LLEGADA_PORTERO',",
          "style": "Normal"
        },
        {
          "index": 45,
          "type": "paragraph",
          "text": "CASE WHEN DIM_HCNCONTRDT.HCCFECSAL IS NULL THEN",
          "style": "Normal"
        },
        {
          "index": 46,
          "type": "paragraph",
          "text": "DIM_TRIAGE.HCTFECTRI end as 'FECHA_TRIAGE',",
          "style": "Normal"
        },
        {
          "index": 47,
          "type": "paragraph",
          "text": "DIM_INGRESO.AINFECING AS 'FECHA_ADMISION',",
          "style": "Normal"
        },
        {
          "index": 48,
          "type": "paragraph",
          "text": "FOL.HCFECFOLI AS 'FECHA_FOLIO',",
          "style": "Normal"
        },
        {
          "index": 49,
          "type": "paragraph",
          "text": "CASE WHEN DIM_ENTIDAD.ENTNOMBRE LIKE '%NUEVA%' THEN 'NUEVA EPS'",
          "style": "Normal"
        },
        {
          "index": 50,
          "type": "paragraph",
          "text": "WHEN DIM_ENTIDAD.ENTNOMBRE LIKE '%SURA%' AND DIM_ENTIDAD.ENTNOMBRE NOT LIKE '%ARL SURA%' AND DIM_ENTIDAD.ENTNOMBRE NOT LIKE '%SEGUROS DE VIDA SURA%' AND DIM_ENTIDAD.ENTNOMBRE NOT LIKE '%SURAMERICANA%' THEN 'SURA'",
          "style": "Normal"
        },
        {
          "index": 51,
          "type": "paragraph",
          "text": "WHEN DIM_ENTIDAD.ENTNOMBRE LIKE '%SANITAS%' AND DIM_ENTIDAD.ENTNOMBRE NOT LIKE '%COLSANITAS%'",
          "style": "Normal"
        },
        {
          "index": 52,
          "type": "paragraph",
          "text": "AND DIM_ENTIDAD.ENTNOMBRE NOT LIKE '%MEDISANITAS%' THEN 'SANITAS'",
          "style": "Normal"
        },
        {
          "index": 53,
          "type": "paragraph",
          "text": "WHEN DIM_ENTIDAD.ENTNOMBRE LIKE '%MALLAMAS%' THEN 'MALLAMAS'",
          "style": "Normal"
        },
        {
          "index": 54,
          "type": "paragraph",
          "text": "ELSE DIM_ENTIDAD.ENTNOMBRE END ASEGURADORA,",
          "style": "Normal"
        },
        {
          "index": 55,
          "type": "paragraph",
          "text": "DATEDIFF(MINUTE,HCTFECTRI,CASE WHEN CAST(HCTFECTRI AS DATE)>='2025-08-01' AND DIM_HCNCLAURGTR.HCCODIGO = 'II' THEN DIM_INGRESO.AINFECING ELSE HCFECFOLI END) TIEMPO_PARA_CONSULTA,",
          "style": "Normal"
        },
        {
          "index": 56,
          "type": "paragraph",
          "text": "CASE WHEN DATEDIFF(YEAR,GPAFECNAC,HCTFECTRI)<18 THEN 'MENORES' ELSE 'MAYORES' END MENORES_EDAD,",
          "style": "Normal"
        },
        {
          "index": 57,
          "type": "paragraph",
          "text": "GENTERCER_DW.OID OID_TERCERO,",
          "style": "Normal"
        },
        {
          "index": 58,
          "type": "paragraph",
          "text": "GENTERCER_DW.TERNOMCOM",
          "style": "Normal"
        },
        {
          "index": 59,
          "type": "paragraph",
          "text": "FROM DIM_TRIAGE",
          "style": "Normal"
        },
        {
          "index": 60,
          "type": "paragraph",
          "text": "RIGHT JOIN DIM_HCNCLAURGTR ON DIM_TRIAGE.HCNCLAURGTR = DIM_HCNCLAURGTR.OID",
          "style": "Normal"
        },
        {
          "index": 61,
          "type": "paragraph",
          "text": "RIGHT JOIN DIM_MEDICO ON DIM_TRIAGE.GENMEDICO = DIM_MEDICO.OID",
          "style": "Normal"
        },
        {
          "index": 62,
          "type": "paragraph",
          "text": "LEFT OUTER JOIN DIM_DIAGNOSTICO ON DIM_TRIAGE.GENDIAGNO1 = DIM_DIAGNOSTICO.OID",
          "style": "Normal"
        },
        {
          "index": 63,
          "type": "paragraph",
          "text": "LEFT OUTER JOIN DIM_HCNCONTRDT ON DIM_HCNCONTRDT.OID = DIM_TRIAGE.HCNCONTRDT",
          "style": "Normal"
        },
        {
          "index": 64,
          "type": "paragraph",
          "text": "LEFT OUTER JOIN DIM_INGRESO ON DIM_INGRESO.OID = DIM_TRIAGE.ADNINGRESO",
          "style": "Normal"
        },
        {
          "index": 65,
          "type": "paragraph",
          "text": "RIGHT JOIN DIM_ENTIDAD ON DIM_INGRESO.GEENENTADM = DIM_ENTIDAD.OID",
          "style": "Normal"
        },
        {
          "index": 66,
          "type": "paragraph",
          "text": "LEFT JOIN DIM_PACIENTES ON DIM_PACIENTES.OID=DIM_INGRESO.GENPACIEN",
          "style": "Normal"
        },
        {
          "index": 67,
          "type": "paragraph",
          "text": "LEFT JOIN DIM_ASEGURADORA ON DIM_INGRESO.GENDETCON=DIM_ASEGURADORA.OID",
          "style": "Normal"
        },
        {
          "index": 68,
          "type": "paragraph",
          "text": "LEFT JOIN GENTERCER_DW ON DIM_ASEGURADORA.GENTERCER1=GENTERCER_DW.OID",
          "style": "Normal"
        },
        {
          "index": 69,
          "type": "paragraph",
          "text": "OUTER APPLY (SELECT TOP 1 HCFECFOLI",
          "style": "Normal"
        },
        {
          "index": 70,
          "type": "paragraph",
          "text": "FROM DIM_FOLIO",
          "style": "Normal"
        },
        {
          "index": 71,
          "type": "paragraph",
          "text": "WHERE DIM_FOLIO.ADNINGRESO = DIM_INGRESO.OID",
          "style": "Normal"
        },
        {
          "index": 72,
          "type": "paragraph",
          "text": "ORDER BY HCFECFOLI ASC ) FOL",
          "style": "Normal"
        },
        {
          "index": 73,
          "type": "paragraph",
          "text": "WHERE",
          "style": "Normal"
        },
        {
          "index": 74,
          "type": "paragraph",
          "text": "CAST(DIM_TRIAGE.HCTFECTRI AS DATE) BETWEEN '2023-01-01' AND CAST(GETDATE() AS DATE)",
          "style": "Normal"
        },
        {
          "index": 75,
          "type": "paragraph",
          "text": "AND DIM_HCNCLAURGTR.HCCODIGO NOT IN ('UA')",
          "style": "Normal"
        },
        {
          "index": 76,
          "type": "paragraph",
          "text": "and DIM_INGRESO.AINESTADO not in ('2','4')",
          "style": "Normal"
        },
        {
          "index": 77,
          "type": "paragraph",
          "text": "ORDER BY DIM_HCNCONTRDT.HCCFECTUR",
          "style": "Normal"
        },
        {
          "index": 78,
          "type": "paragraph",
          "text": "MEDIDAS UTILIZADAS EN ESTE TABLERO",
          "style": "Normal"
        },
        {
          "type": "table",
          "rows": [
            [
              "Tabla",
              "Nombre Medida",
              "DAX"
            ],
            [
              "CONSULTA_URGENCIAS",
              "PRIORITARIAS_2025",
              "CALCULATE(\n COUNT(CONSULTA_URGENCIAS[OID_TRIAGE]),\n YEAR(CONSULTA_URGENCIAS[FECHA_FOLIO]) = YEAR(TODAY()\n ))"
            ],
            [
              "CONSULTA_URGENCIAS",
              "PRIORITARIAS_2024",
              "CALCULATE(\n COUNT(CONSULTA_URGENCIAS[OID_TRIAGE]),\n YEAR(CONSULTA_URGENCIAS[FECHA_FOLIO]) = YEAR(TODAY()-1)\n )"
            ]
          ],
          "index": 79
        },
        {
          "index": 81,
          "type": "paragraph",
          "text": "DESCRIPCIÓN DE LOS VISUALES",
          "style": "Normal"
        },
        {
          "index": 82,
          "type": "paragraph",
          "text": "Filtros",
          "style": "Normal"
        },
        {
          "index": 83,
          "type": "paragraph",
          "text": "Permiten segmentar la información por Aseguradora, Año y Mes, facilitando el análisis de las consultas pediátricas según los criterios seleccionados.",
          "style": "Normal"
        },
        {
          "index": 85,
          "type": "paragraph",
          "text": "Gráfico de líneas – Consultas pediátricas por mes",
          "style": "Normal"
        },
        {
          "index": 86,
          "type": "paragraph",
          "text": "Muestra la cantidad de consultas pediátricas registradas por mes, permitiendo analizar su comportamiento y variación en los diferentes años.",
          "style": "Normal"
        },
        {
          "index": 88,
          "type": "paragraph",
          "text": "Gráfico circular – Consultas pediátricas por clasificación de triage",
          "style": "Normal"
        },
        {
          "index": 89,
          "type": "paragraph",
          "text": "Presenta la distribución de las consultas pediátricas según su clasificación de triage, permitiendo identificar la proporción de cada nivel de atención.",
          "style": "Normal"
        },
        {
          "index": 92,
          "type": "paragraph",
          "text": "Tabla de detalle anual",
          "style": "Normal"
        },
        {
          "index": 93,
          "type": "paragraph",
          "text": "Muestra el consolidado mensual de consultas pediátricas por año, facilitando el análisis y comparación del comportamiento histórico de este indicador.",
          "style": "Normal"
        },
        {
          "index": 94,
          "type": "paragraph",
          "text": "Principio del formulario",
          "style": "Normal"
        },
        {
          "index": 95,
          "type": "paragraph",
          "text": "Final del formulario",
          "style": "Normal"
        }
      ]
    }
  ]
}