{
  "source_file": "Documentacion Tablero Atenciones Pediatricas Consultas.docx",
  "relative_path": "tablero_de_atenciones_institucionales\\Documentacion Tablero Atenciones Pediatricas Consultas.docx",
  "source_folder": "tablero_de_atenciones_institucionales",
